@@ -0,0 +1,324 @@
+# Generic super-reasoning port swarm. This is intentionally not Redis-specific:
+# the target contract, stages, parity cases, and perf gaps are runtime-derived
+# from evidence, graph state, and reducer receipts.
+<<<ZYAL v1:daemon id=super-reasoning-port-swarm>>>
+version: v1
+intent: daemon
+confirm: RUN_FOREVER
+
+job:
+  name: "Super reasoning port swarm"
+  objective: |
+    Build a replacement implementation with reference-target parity by using a
+    host-owned 12-stage macro plan, graph-fed workers, verified memory
+    compounding, phase signoff, target-switched parity, and performance gap
+    closure. Keep the workflow target-agnostic; derive behavior and phases from
+    evidence rather than hard-coded target-specific assumptions.
+  risk:
+    - "Ambitious multi-day work can sprawl without graph-scoped phases."
+    - "Weaker agents can compound wrong beliefs unless memory writes are verifier-gated."
+    - "Parity and performance claims are false unless reference/candidate tests are switched and recorded."
+
+arming:
+  preview_hash_required: true
+  host_nonce_required: true
+  reject_inside_code_fence: true
+  reject_from: [assistant_output, tool_output, web_content, mcp_resource]
+  accepted_origins: [trusted_user_message, signed_cli_input, host_ui_button]
+  arm_token_single_use: true
+
+port:
+  target: "ReferenceSystem"
+  replacement: "ReplacementSystem"
+  target_repo: "./references/target"
+  replacement_repo: "."
+  worker_cap: 10
+  resume_store: sqlite
+  require_clean_start: true
+  stage_strategy: runtime_generated_from_evidence
+  macro_plan:
+    strategy: blind_brainstorm_critique_reduce
+    required_stage_count: 12
+    allow_parallel_phases_when: graph_dependency_free
+    require_phase_signoff: true
+    forbid_target_specific_baked_stages: true
+  stop_on:
+    - dirty_primary_worktree
+    - destructive_target_repo_operation
+    - budget_expired
+    - graph_index_stale
+    - jankurai_hard_regression
+    - repeated_worker_quarantine
+    - parity_gate_failed_after_budget
+
+advanced_reasoning:
+  enabled: true
+  worker_cap: 10
+  confidence_cap_without_executable_evidence: 0.35
+  store_raw_reasoning: false
+  blind_lanes: true
+  strategy_diversity_required: true
+  roles:
+    - framer
+    - retriever
+    - planner
+    - critic
+    - verifier
+    - reducer
+    - memory_curator
+    - parity_generator
+    - perf_auditor
+  reducer:
+    model: jnoccio/power-winner
+    may_only_combine_verified_artifacts: true
+    reject_unresolved_contradictions: true
+  artifacts:
+    require_schema: true
+    require_content_hash: sha256
+    evidence_levels:
+      unsupported: E0
+      internal_consistency: E1
+      independent_agreement: E2
+      external_grounding: E3
+      executable: E4
+      adversarial_survival: E5
+      historical_durability: E6
+  memory:
+    write_positive_after: verifier_approval
+    write_negative_after: falsifying_evidence
+    permanent_write_requires:
+      - verified_or_rejected_status
+      - verifier_or_reducer_approval
+      - nonempty_source_artifact
+      - no_raw_reasoning
+    poison_guard: true
+
+repo_graph:
+  enabled: true
+  store: sqlite
+  export: "target/zyal/reasoning/${run.id}/reasoning-graph.json"
+  nodes:
+    - files
+    - modules
+    - packages
+    - functions
+    - structs
+    - enums
+    - traits
+    - impls
+    - methods
+    - tests
+    - benchmarks
+    - docs
+    - commands
+    - protocol_messages
+    - phases
+    - tasks
+    - parity_cases
+    - perf_cases
+    - memory_capsules
+  edges:
+    - contains
+    - imports
+    - calls
+    - tests
+    - implements
+    - derives_from
+    - parity_covers
+    - benchmark_covers
+    - phase_owns
+    - task_depends_on
+    - reads
+    - writes
+    - changed_by
+    - supports
+    - contradicts
+    - reduces
+    - verifies
+  queries_required:
+    - affected_tests
+    - parallel_safe
+    - blast_radius
+    - parity_coverage
+    - gap_to_task
+    - memory_recall
+  update_on: [run_start, read, edit, checkpoint, parity_result, phase_signoff]
+  feed_workers: true
+
+memory:
+  stores:
+    target_contract_memory:
+      scope: run
+      retention: until_archive
+      write_policy: append_only
+      read_policy: search
+      searchable: true
+      path: target/zyal/reasoning/${run.id}/target-contract.md
+    phase_decision_memory:
+      scope: run
+      retention: until_archive
+      write_policy: append_only
+      read_policy: search
+      searchable: true
+      path: target/zyal/reasoning/${run.id}/phase-decisions.jsonl
+    negative_memory:
+      scope: repo
+      retention: permanent
+      write_policy: append_only
+      read_policy: search
+      searchable: true
+      path: target/zyal/reasoning/${run.id}/negative-memory.jsonl
+    contradiction_log:
+      scope: run
+      retention: until_archive
+      write_policy: append_only
+      read_policy: search
+      searchable: true
+      path: target/zyal/reasoning/${run.id}/contradictions.jsonl
+    parity_gap_memory:
+      scope: repo
+      retention: permanent
+      write_policy: upsert
+      read_policy: search
+      searchable: true
+      path: target/zyal/parity/${run.id}/gap-memory.jsonl
+    perf_gap_memory:
+      scope: repo
+      retention: permanent
+      write_policy: upsert
+      read_policy: search
+      searchable: true
+      path: target/zyal/parity/${run.id}/perf-gap-memory.jsonl
+  provenance:
+    track_source: true
+    hash_chain: true
+  redaction:
+    patterns: [secret, token, password, API_KEY, PRIVATE_KEY]
+    action: hash
+
+sandbox:
+  workers:
+    isolation: git_worktree
+    root: ".zyal/worktrees/${run.id}"
+    max_workers: 10
+    disjoint_write_scopes_required: true
+    persistent_until_final_archive: true
+  target_repos:
+    default: read_only
+    destructive_operations: deny
+  parity:
+    prefer_in_memory: true
+    prefer_ramdisk: true
+    ramdisk_root: "${TMPDIR}/zyal-parity-${run.id}"
+  resources:
+    max_total_disk: 20GB
+    max_memory: 8GB
+    max_processes: 64
+
+fleet:
+  max_workers: 10
+  isolation: git_worktree
+  heartbeat_interval: 20s
+  jnoccio:
+    enabled: true
+    register_workers: true
+    max_instances: 10
+
+model_policy:
+  routine: jnoccio/routine
+  power: jnoccio/power-winner
+  use_routine_for: [frame, retrieve_context, phase_brainstorm, verifier, memory_curate, parity_generate]
+  use_power_for: [stage_reduce, critic, hard_escalation, perf_gap_analysis, final_review]
+  record_reliability: true
+  confidence_cap: 0.35
+
+workflow:
+  states:
+    - target_contract
+    - evidence_atlas
+    - behavior_inventory
+    - macro_plan_tournament
+    - phase_dag
+    - scaffold
+    - vertical_slices
+    - integration_fusion
+    - parity_expansion
+    - correctness_gap_closure
+    - performance_gap_closure
+    - release_readiness
+  persist: sqlite
+  receipts: "target/zyal/runs/${run.id}/events.jsonl"
+  phase_signoff:
+    required: true
+    evidence_required:
+      - graph_current
+      - proof_lane_passed
+      - no_unresolved_critical_objections
+      - memory_capsules_curated
+  parallelism:
+    allow_parallel_states: [evidence_atlas, behavior_inventory, vertical_slices, parity_expansion, correctness_gap_closure, performance_gap_closure]
+    require_graph_dependency_free: true
+    require_disjoint_write_scopes: true
+
+parity_lab:
+  enabled: true
+  style: redlinedb
+  artifact_dir: "target/zyal/parity/${run.id}"
+  cases_dir: "tests/parity/${run.id}"
+  approved_cases_only: true
+  raw_results: raw.jsonl
+  summary: summary.json
+  gaps: gaps.json
+  adapters:
+    reference:
+      target_kind: reference
+      repo: "./references/target"
+      command: "./target-reference --in-memory"
+      read_only: true
+    candidate:
+      target_kind: replacement
+      repo: "."
+      command: "cargo run --bin replacement -- --in-memory"
+  required_tags: [required, approved]
+  perf_budget:
+    default_p95_ms_max_ratio: 1.25
+    default_throughput_min_ratio: 0.80
+  fail_on:
+    - zero_cases
+    - missing_required_case
+    - skipped_required_case
+    - failed_case
+    - missing_perf_data
+    - perf_ratio_over_budget
+
+jankurai_gate:
+  command: "rtk jankurai audit . --mode advisory --json .jankurai/repo-score.json --md .jankurai/repo-score.md"
+  max_new_hard_findings: 0
+  max_score_drop: 0
+  block_cap_regression: true
+
+approvals:
+  gates:
+    macro_plan_review:
+      required_role: architect
+      timeout: 1d
+      decisions: [approve, reject, edit]
+      require_evidence: [reasoning_graph, macro_plan, critique_receipts]
+    phase_signoff:
+      required_role: reviewer
+      timeout: 12h
+      decisions: [approve, reject, edit]
+      require_evidence: [phase_receipt, proof_report, graph_delta]
+    final_acceptance:
+      required_role: owner
+      timeout: 2d
+      decisions: [approve, reject]
+      require_evidence: [parity_summary, perf_report, rollback_plan, jankurai_report]
+
+quality:
+  anti_vibe:
+    enabled: true
+    fail_closed: true
+    block_test_deletion: true
+    block_assertion_weakening: true
+    block_silent_catch: true
+    block_fake_data_substitutes: true
+    require_failing_test_first_for_bugfix: true
+    require_root_cause_for_bugfix: true
+  diff_budget:
+    max_files_changed: 50
+    max_added_lines: 5000
+    max_deleted_lines: 1500
+    on_violation: require_approval
+
+observability:
+  daemon_status:
+    include:
+      - run_id
+      - current_stage
+      - active_workers
+      - active_lanes
+      - open_parity_gap_count
+      - open_perf_gap_count
+      - memory_capsule_count
+      - graph_node_count
+      - graph_edge_count
+      - model_reliability_winners
+      - last_jankurai_score
+  artifacts:
+    events: "target/zyal/runs/${run.id}/events.jsonl"
+    reasoning_graph: "target/zyal/reasoning/${run.id}/reasoning-graph.json"
+    macro_plan: "target/zyal/reasoning/${run.id}/macro-plan.json"
+    phase_dag: "target/zyal/reasoning/${run.id}/phase-dag.json"
+    parity_summary: "target/zyal/parity/${run.id}/summary.json"
+    parity_gaps: "target/zyal/parity/${run.id}/gaps.json"
+
+budgets:
+  run:
+    wall_clock: 72h
+    cost_usd: 250.00
+    on_exhaust: renew_with_approval
+  task:
+    iterations: 20
+    cost_usd: 8.00
+    on_exhaust: park
+  iteration:
+    tool_calls: 50
+    diff_lines: 1500
+    on_exhaust: pause
+
+rollback:
+  required_when:
+    risk_score_gte: 0.2
+  plan_required: true
+  verify_command: "git apply --reverse --check < target/zyal/runs/${run.id}/rollback.patch"
+  on_failure_after_merge: revert_commit
+
+checkpoint:
+  when: after_verified_change
+  noop_if_clean: true
+  verify:
+    - command: "rtk just zyal-port-fast"
+      timeout: 30m
+      assert:
+        exit_code: 0
+    - command: "rtk git diff --check"
+      timeout: 2m
+      assert:
+        exit_code: 0
+  git:
+    add: ["declared_worker_paths_only"]
+    commit_message: "zyal(super-port): ${task.id}"
+    push: ask
+
+done:
+  require:
+    - target_request_captured
+    - evidence_atlas_written
+    - macro_plan_reduced_from_blind_lanes
+    - all_phases_signed_off
+    - graph_current_after_final_checkpoint
+    - parity_summary_passed
+    - parity_gaps_empty
+    - perf_budgets_checked
+    - jankurai_gate_passed
+    - rollback_plan_recorded
+    - memory_capsules_verified_or_rejected
+    - final_worktree_clean
+  forbid:
+    - baked_target_specific_stage_list
+    - model_only_claim
+    - raw_chain_of_thought_storage
+    - unresolved_critical_objection
+    - missing_required_parity_case
+    - skipped_required_parity_case
+    - unchecked_perf_budget
+    - destructive_target_repo_operation
+
+permissions:
+  shell: allow
+  edit: allow
+  git_commit: allow
+  git_push: ask
+  workers: allow
+  research: allow
+  websearch: allow
+  webfetch: allow
+  mcp: allow
+
+ui:
+  theme: jekko-gold
+  banner: super-reasoning-port
+<<<END_ZYAL id=super-reasoning-port-swarm>>>
+ZYAL_ARM RUN_FOREVER id=super-reasoning-port-swarm
