+/// Parsed top-level envelope for the advanced port/reasoning ZYAL blocks.
+#[derive(Debug, Clone, PartialEq, Serialize, Deserialize)]
+pub struct ZyalPortSuperEnvelope {
+    /// Runtime sentinel version.
+    pub version: Option<String>,
+    /// Runtime intent.
+    pub intent: Option<String>,
+    /// Confirmation literal.
+    pub confirm: Option<String>,
+    /// Optional run id. If absent, the compiler derives one from the plan hash.
+    pub id: Option<String>,
+    /// Job framing.
+    pub job: JobBlock,
+    /// Generic reference-to-replacement port configuration.
+    pub port: PortBlock,
+    /// Advanced reasoning lane policy.
+    #[serde(default)]
+    pub advanced_reasoning: Option<AdvancedReasoningBlock>,
+    /// Repository graph policy.
+    #[serde(default)]
+    pub repo_graph: Option<RepoGraphBlock>,
+    /// Target-switched parity/performance lab policy.
+    #[serde(default)]
+    pub parity_lab: Option<ParityLabBlock>,
+    /// Model routing and outcome recording policy.
+    #[serde(default)]
+    pub model_policy: Option<ModelPolicyBlock>,
+    /// Optional workflow block from the runbook.
+    #[serde(default)]
+    pub workflow: Option<WorkflowBlock>,
+    /// Optional sandbox block, preserved in the compiled payload.
+    #[serde(default)]
+    pub sandbox: Option<serde_json::Value>,
+    /// Optional done block.
+    #[serde(default)]
+    pub done: Option<DoneBlock>,
+}
