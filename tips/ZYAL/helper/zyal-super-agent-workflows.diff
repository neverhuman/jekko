+//! Pure compiler for ZYAL super-agent port workflows.
+//!
+//! This module intentionally performs no I/O and does not call models. It turns
+//! the advanced ZYAL blocks already used by the flagship port/reasoning
+//! examples into a deterministic, host-owned execution plan that the runtime can
+//! seed into SQLite before any worker starts.
+
+use std::collections::{BTreeMap, BTreeSet};
+
+use serde::{Deserialize, Serialize};
+use sha2::{Digest, Sha256};
+
+use crate::error::{CoreError, CoreResult};
+
+const SURFACE: &str = "zyal.port_super";
+const DEFAULT_MAX_WORKERS: u16 = 10;
+const MAX_WORKERS: u16 = 20;
