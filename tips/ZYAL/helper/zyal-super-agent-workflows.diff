+/// Compile a sentinel-wrapped or raw YAML ZYAL port/reasoning runbook.
+pub fn compile_port_super_plan(raw: &str) -> CoreResult<CompiledPortSuperPlan> {
+    let body = extract_zyal_body(raw)?;
+    compile_port_super_plan_from_body(&body)
+}
+
+/// Compile a raw YAML body without sentinel wrappers.
+pub fn compile_port_super_plan_from_body(body: &str) -> CoreResult<CompiledPortSuperPlan> {
+    let envelope: ZyalPortSuperEnvelope = serde_yaml::from_str(body).map_err(|err| parse(err))?;
+    validate_envelope(&envelope)?;
+
+    let worker_cap = envelope
+        .port
+        .worker_cap
+        .or_else(|| envelope.advanced_reasoning.as_ref().and_then(|a| a.worker_cap))
+        .unwrap_or(DEFAULT_MAX_WORKERS)
+        .clamp(1, MAX_WORKERS);
+    let strategy = envelope
+        .port
+        .stage_strategy
+        .clone()
+        .or_else(|| envelope.port.phase_strategy.clone())
+        .unwrap_or_else(|| "runtime_generated_from_evidence".to_string());
+    let phases = default_phases();
+    validate_phase_graph(&phases)?;
+    let lanes = compile_lanes(envelope.advanced_reasoning.as_ref(), worker_cap);
+    let repo_graph = compile_repo_graph(envelope.repo_graph.as_ref());
+    let parity_lab = compile_parity(envelope.parity_lab.as_ref());
+    let memory = compile_memory(envelope.advanced_reasoning.as_ref());
+    let model_policy = compile_model_policy(envelope.model_policy.as_ref());
+    let done = envelope.done.clone().unwrap_or_else(default_done);
+    let source_workflow_states = envelope
+        .workflow
+        .as_ref()
+        .map(|w| w.states.clone())
+        .unwrap_or_default();
+
+    let mut plan = CompiledPortSuperPlan {
+        plan_hash: String::new(),
+        run_id: envelope
+            .id
+            .clone()
+            .unwrap_or_else(|| "port-super-plan-pending-hash".to_string()),
+        job_name: envelope.job.name.clone(),
+        objective: envelope.job.objective.clone(),
+        target: TargetDescriptor {
+            name: envelope.port.target.clone(),
+            repo: envelope.port.target_repo.clone(),
+        },
+        replacement: TargetDescriptor {
+            name: envelope.port.replacement.clone(),
+            repo: envelope.port.replacement_repo.clone(),
+        },
+        worker_cap,
+        stage_strategy: strategy,
+        phases,
+        lanes,
+        repo_graph,
+        parity_lab,
+        memory,
+        model_policy,
+        done,
+        source_workflow_states,
+    };
+    finalize_plan_hash(&mut plan)?;
+    Ok(plan)
+}
+
+fn finalize_plan_hash(plan: &mut CompiledPortSuperPlan) -> CoreResult<()> {
+    plan.plan_hash.clear();
+    let first_hash = stable_hash(plan)?;
+    if plan.run_id == "port-super-plan-pending-hash" {
+        plan.run_id = format!("port-super-{}", &first_hash[..12]);
+    }
+    plan.plan_hash.clear();
+    plan.plan_hash = stable_hash(plan)?;
+    Ok(())
+}
+
+fn validate_envelope(envelope: &ZyalPortSuperEnvelope) -> CoreResult<()> {
+    if envelope.port.target.trim().is_empty() {
+        return Err(parse_msg("port.target must be non-empty"));
+    }
+    if envelope.port.replacement.trim().is_empty() {
+        return Err(parse_msg("port.replacement must be non-empty"));
+    }
+    let cap = envelope
+        .port
+        .worker_cap
+        .or_else(|| envelope.advanced_reasoning.as_ref().and_then(|a| a.worker_cap))
+        .unwrap_or(DEFAULT_MAX_WORKERS);
+    if cap == 0 || cap > MAX_WORKERS {
+        return Err(parse_msg(format!(
+            "worker cap must be between 1 and {MAX_WORKERS}; got {cap}"
+        )));
+    }
+    if let Some(reasoning) = &envelope.advanced_reasoning {
+        if reasoning.store_raw_reasoning {
+            return Err(parse_msg(
+                "advanced_reasoning.store_raw_reasoning must be false for super-agent runs",
+            ));
+        }
+    }
+    if let Some(parity) = &envelope.parity_lab {
+        if parity.enabled {
+            let fail_on: BTreeSet<_> = parity.fail_on.iter().map(String::as_str).collect();
+            for required in ["zero_cases", "failed_case", "missing_required_case"] {
+                if !fail_on.contains(required) {
+                    return Err(parse_msg(format!(
+                        "parity_lab.fail_on must include '{required}'"
+                    )));
+                }
+            }
+        }
+    }
+    Ok(())
+}
+
+fn validate_phase_graph(phases: &[CompiledPhase]) -> CoreResult<()> {
+    if !(9..=12).contains(&phases.len()) {
+        return Err(parse_msg(format!(
+            "super-agent macro plan must have 9-12 phases; got {}",
+            phases.len()
+        )));
+    }
+    let ids: BTreeSet<_> = phases.iter().map(|p| p.id.as_str()).collect();
+    for phase in phases {
+        for dep in &phase.depends_on {
+            if !ids.contains(dep.as_str()) {
+                return Err(parse_msg(format!(
+                    "phase '{}' depends on unknown phase '{dep}'",
+                    phase.id
+                )));
+            }
+        }
+    }
+    let mut visiting = BTreeSet::new();
+    let mut visited = BTreeSet::new();
+    let map: BTreeMap<_, _> = phases.iter().map(|p| (p.id.as_str(), p)).collect();
+    for phase in phases {
+        detect_cycle(phase.id.as_str(), &map, &mut visiting, &mut visited)?;
+    }
+    Ok(())
+}
+
+fn detect_cycle<'a>(
+    id: &'a str,
+    map: &BTreeMap<&'a str, &'a CompiledPhase>,
+    visiting: &mut BTreeSet<&'a str>,
+    visited: &mut BTreeSet<&'a str>,
+) -> CoreResult<()> {
+    if visited.contains(id) {
+        return Ok(());
+    }
+    if !visiting.insert(id) {
+        return Err(parse_msg(format!("phase dependency cycle at '{id}'")));
+    }
+    if let Some(phase) = map.get(id) {
+        for dep in &phase.depends_on {
+            detect_cycle(dep.as_str(), map, visiting, visited)?;
+        }
+    }
+    visiting.remove(id);
+    visited.insert(id);
+    Ok(())
+}
+
+fn compile_lanes(
+    reasoning: Option<&AdvancedReasoningBlock>,
+    worker_cap: u16,
+) -> Vec<CompiledReasoningLane> {
+    let default_roles = vec![
+        "framer",
+        "retriever",
+        "stage_planner",
+        "builder",
+        "parity_author",
+        "critic",
+        "verifier",
+        "reducer",
+        "performance_hunter",
+        "memory_curator",
+        "integrator",
+    ];
+    let roles: Vec<String> = reasoning
+        .map(|r| r.roles.clone())
+        .filter(|r| !r.is_empty())
+        .unwrap_or_else(|| default_roles.iter().map(|r| (*r).to_string()).collect());
+    roles
+        .into_iter()
+        .take(worker_cap as usize)
+        .map(|role| CompiledReasoningLane {
+            id: format!("lane-{role}"),
+            role,
+            strategy: "blind_then_critic_then_reduce".to_string(),
+            write_scope: vec!["scratch_only".to_string()],
+        })
+        .collect()
+}
+
+fn compile_repo_graph(repo_graph: Option<&RepoGraphBlock>) -> CompiledRepoGraphPolicy {
+    let defaults_nodes = [
+        "target",
+        "replacement",
+        "stage",
+        "task",
+        "files",
+        "modules",
+        "functions",
+        "commands",
+        "tests",
+        "parity_cases",
+        "perf_budgets",
+    ];
+    let default_edges = [
+        "contains",
+        "imports",
+        "calls",
+        "tests",
+        "implements",
+        "depends_on",
+        "phase_owns",
+        "task_touches",
+        "parity_covers",
+        "changed_by",
+        "supports",
+        "critiques",
+        "reduces",
+    ];
+    CompiledRepoGraphPolicy {
+        enabled: repo_graph.map(|r| r.enabled).unwrap_or(true),
+        store: repo_graph
+            .and_then(|r| r.store.clone())
+            .unwrap_or_else(|| "sqlite".to_string()),
+        nodes: repo_graph
+            .map(|r| r.nodes.clone())
+            .filter(|v| !v.is_empty())
+            .unwrap_or_else(|| defaults_nodes.iter().map(|s| (*s).to_string()).collect()),
+        edges: repo_graph
+            .map(|r| r.edges.clone())
+            .filter(|v| !v.is_empty())
+            .unwrap_or_else(|| default_edges.iter().map(|s| (*s).to_string()).collect()),
+        export: repo_graph.and_then(|r| r.export.clone()),
+        feed_workers: repo_graph.and_then(|r| r.feed_workers).unwrap_or(true),
+    }
+}
+
+fn compile_parity(parity: Option<&ParityLabBlock>) -> CompiledParityPolicy {
+    let adapters = parity.and_then(|p| p.adapters.clone());
+    CompiledParityPolicy {
+        enabled: parity.map(|p| p.enabled).unwrap_or(true),
+        style: parity
+            .and_then(|p| p.style.clone())
+            .unwrap_or_else(|| "target_switched".to_string()),
+        artifact_dir: parity.and_then(|p| p.artifact_dir.clone()),
+        cases_dir: parity.and_then(|p| p.cases_dir.clone()),
+        required_tags: parity
+            .map(|p| p.required_tags.clone())
+            .filter(|v| !v.is_empty())
+            .unwrap_or_else(|| vec!["required".into(), "approved".into()]),
+        fail_on: parity
+            .map(|p| p.fail_on.clone())
+            .filter(|v| !v.is_empty())
+            .unwrap_or_else(|| {
+                vec![
+                    "zero_cases".into(),
+                    "missing_required_case".into(),
+                    "skipped_required_case".into(),
+                    "failed_case".into(),
+                    "missing_perf_data".into(),
+                    "perf_ratio_over_budget".into(),
+                ]
+            }),
+        reference: adapters.as_ref().map(|a| a.reference.clone()),
+        candidate: adapters.as_ref().map(|a| a.candidate.clone()),
+    }
+}
+
+fn compile_memory(reasoning: Option<&AdvancedReasoningBlock>) -> CompiledMemoryPolicy {
+    CompiledMemoryPolicy {
+        store_raw_reasoning: false,
+        positive_write_gate: "verifier_or_reducer_approval".to_string(),
+        negative_write_gate: "falsifying_evidence".to_string(),
+        poison_guard: true,
+        confidence_cap_without_executable_evidence: reasoning
+            .and_then(|r| r.confidence_cap_without_executable_evidence)
+            .unwrap_or(0.35),
+    }
+}
+
+fn compile_model_policy(model: Option<&ModelPolicyBlock>) -> CompiledModelPolicy {
+    CompiledModelPolicy {
+        routine: model.and_then(|m| m.routine.clone()),
+        power: model.and_then(|m| m.power.clone()),
+        record_reliability: model
+            .and_then(|m| m.record_reliability.or(m.record_outcomes))
+            .unwrap_or(true),
+    }
+}
+
+fn default_done() -> DoneBlock {
+    DoneBlock {
+        require: vec![
+            "target_request_captured".into(),
+            "master_plan_generated_from_runtime_evidence".into(),
+            "phases_complete".into(),
+            "jankurai_gate_passed".into(),
+            "parity_gate_passed".into(),
+            "perf_budgets_checked".into(),
+            "memory_capsules_verified_or_rejected".into(),
+        ],
+        forbid: vec![
+            "model_only_claim".into(),
+            "raw_chain_of_thought_storage".into(),
+            "missing_required_parity_case".into(),
+            "skipped_required_parity_case".into(),
+            "unchecked_perf_budget".into(),
+        ],
+    }
+}
+
+fn default_phases() -> Vec<CompiledPhase> {
+    let specs = vec![
+        (
+            "scope-contract",
+            "Scope contract",
+            "Capture request, success criteria, non-goals, trust boundaries, budgets, and stop conditions.",
+            vec![],
+            vec![],
+        ),
+        (
+            "reference-inventory",
+            "Reference inventory",
+            "Inventory docs, source, tests, examples, APIs, commands, protocol behavior, and executable references.",
+            vec!["scope-contract"],
+            vec!["repo-graph-risk"],
+        ),
+        (
+            "repo-graph-risk",
+            "Repo graph and risk map",
+            "Seed the repo graph, map blast radius, identify generated zones, tests, parity surfaces, and high-risk boundaries.",
+            vec!["scope-contract"],
+            vec!["reference-inventory"],
+        ),
+        (
+            "architecture-plan",
+            "Architecture plan",
+            "Reduce evidence into the target architecture, module boundaries, data model, runtime model, and rollback strategy.",
+            vec!["reference-inventory", "repo-graph-risk"],
+            vec![],
+        ),
+        (
+            "core-surface",
+            "Core surface implementation",
+            "Build the central interfaces, command/API shell, persistence shell, and minimal executable skeleton.",
+            vec!["architecture-plan"],
+            vec!["parity-harness"],
+        ),
+        (
+            "feature-semantics",
+            "Feature semantics waves",
+            "Execute bounded behavior clusters in isolated worktrees with critic and verifier lanes.",
+            vec!["core-surface"],
+            vec!["parity-harness"],
+        ),
+        (
+            "parity-harness",
+            "Parity harness and case library",
+            "Build target-switched reference/candidate adapters, approved cases, raw JSONL results, summaries, and gap extraction.",
+            vec!["architecture-plan"],
+            vec!["core-surface", "feature-semantics"],
+        ),
+        (
+            "integration-fusion",
+            "Integration and fusion",
+            "Fuse green worktrees, resolve conflicts, refresh graph, re-run proof lanes, and quarantine failed lanes.",
+            vec!["feature-semantics", "parity-harness"],
+            vec![],
+        ),
+        (
+            "performance-closure",
+            "Performance closure",
+            "Profile reference/candidate gaps, optimize hot paths, enforce p95/p99/RSS budgets, and re-run parity.",
+            vec!["integration-fusion"],
+            vec![],
+        ),
+        (
+            "release-signoff",
+            "Release sign-off",
+            "Verify parity, performance, Jankurai, rollback, memory, repo graph, and clean-tree evidence before done.",
+            vec!["performance-closure"],
+            vec![],
+        ),
+    ];
+
+    specs
+        .into_iter()
+        .enumerate()
+        .map(|(idx, (id, name, objective, deps, parallel))| {
+            let ordinal = (idx + 1) as u8;
+            CompiledPhase {
+                id: id.to_string(),
+                ordinal,
+                name: name.to_string(),
+                objective: objective.to_string(),
+                strategy: "plan_build_verify_reduce".to_string(),
+                depends_on: deps.into_iter().map(str::to_string).collect(),
+                can_run_parallel_with: parallel.into_iter().map(str::to_string).collect(),
+                gates: vec![
+                    "no_unresolved_critical_objections".into(),
+                    "proof_commands_pass".into(),
+                    "memory_capsules_verified_or_rejected".into(),
+                    "repo_graph_updated".into(),
+                    "rollback_known_when_risky".into(),
+                ],
+                task_seeds: default_tasks_for_phase(id, ordinal),
+            }
+        })
+        .collect()
+}
+
+fn default_tasks_for_phase(phase_id: &str, ordinal: u8) -> Vec<CompiledTaskSeed> {
+    let prefix = format!("p{ordinal:02}-{phase_id}");
+    vec![
+        CompiledTaskSeed {
+            id: format!("{prefix}-plan"),
+            title: format!("Plan {phase_id}"),
+            role: "stage_planner".into(),
+            write_scope: vec!["scratch_only".into()],
+            proof_lane: "planning_review".into(),
+        },
+        CompiledTaskSeed {
+            id: format!("{prefix}-build"),
+            title: format!("Execute {phase_id}"),
+            role: "builder".into(),
+            write_scope: vec!["declared_worker_paths_only".into()],
+            proof_lane: "phase_verify".into(),
+        },
+        CompiledTaskSeed {
+            id: format!("{prefix}-verify"),
+            title: format!("Verify {phase_id}"),
+            role: "verifier".into(),
+            write_scope: vec!["scratch_only".into(), "target/zyal/**".into()],
+            proof_lane: "executable_evidence".into(),
+        },
+        CompiledTaskSeed {
+            id: format!("{prefix}-memory"),
+            title: format!("Curate memory for {phase_id}"),
+            role: "memory_curator".into(),
+            write_scope: vec!["target/zyal/**".into(), ".jekko/daemon/**".into()],
+            proof_lane: "memory_review".into(),
+        },
+    ]
+}
+
+fn extract_zyal_body(raw: &str) -> CoreResult<String> {
+    if !raw.contains("<<<ZYAL") {
+        return Ok(raw.trim().to_string());
+    }
+    let start = raw
+        .find(">>>")
+        .ok_or_else(|| parse_msg("missing ZYAL start sentinel close marker '>>>'"))?;
+    let rest = &raw[start + 3..];
+    let end = rest
+        .find("<<<END_ZYAL")
+        .ok_or_else(|| parse_msg("missing END_ZYAL sentinel"))?;
+    Ok(rest[..end].trim().to_string())
+}
+
+fn stable_hash<T: Serialize>(value: &T) -> CoreResult<String> {
+    let json = serde_json::to_vec(value).map_err(|err| CoreError::Parse {
+        surface: SURFACE,
+        message: err.to_string(),
+    })?;
+    let mut hasher = Sha256::new();
+    hasher.update(json);
+    Ok(format!("{:x}", hasher.finalize()))
+}
+
+fn parse(err: serde_yaml::Error) -> CoreError {
+    CoreError::Parse {
+        surface: SURFACE,
+        message: err.to_string(),
+    }
+}
+
+fn parse_msg(message: impl Into<String>) -> CoreError {
+    CoreError::Parse {
+        surface: SURFACE,
+        message: message.into(),
+    }
+}
