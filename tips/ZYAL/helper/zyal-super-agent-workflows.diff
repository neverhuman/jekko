+# Runtime-wired generic super-agent port kernel. This is intentionally not
+# target-specific: replace MiniKV with Redis, SQLite, a public API, or any other
+# reference system without changing the workflow shape.
+<<<ZYAL v1:daemon id=super-agent-port-kernel>>>
+version: v1
+intent: daemon
+confirm: RUN_FOREVER
+
+job:
+  name: "Super-agent port kernel"
+  objective: |
+    Build a replacement implementation with reference-target parity. Before
+    launching workers, compile a host-owned 10-stage master plan, seed durable
+    phases/tasks/lanes/memory/graph rows, then execute bounded worktree workers
+    with parity, performance, Jankurai, rollback, and memory sign-off.
+  risk:
+    - "Do not launch workers before the compiled plan is durable."
+    - "Do not store raw chain-of-thought."
+    - "Do not accept model-only parity claims."
+
+port:
+  target: "MiniKV"
+  replacement: "MiniKV Rust"
+  target_repo: "./fixtures/minikv-reference"
+  replacement_repo: "."
+  worker_cap: 10
+  resume_store: sqlite
+  require_clean_start: true
+  stage_strategy: runtime_generated_from_evidence
+  stop_on:
+    - dirty_primary_worktree
+    - destructive_target_repo_operation
+    - budget_expired
+    - repeated_worker_quarantine
+
+advanced_reasoning:
+  enabled: true
+  worker_cap: 10
+  confidence_cap_without_executable_evidence: 0.35
+  store_raw_reasoning: false
+  blind_lanes: true
+  strategy_diversity_required: true
+  roles:
+    - framer
+    - retriever
+    - stage_planner
+    - builder
+    - parity_author
+    - critic
+    - verifier
+    - reducer
+    - performance_hunter
+    - memory_curator
+  memory:
+    write_positive_after: verifier_or_reducer_approval
+    write_negative_after: falsifying_evidence
+    poison_guard: true
+
+repo_graph:
+  enabled: true
+  store: sqlite
+  export: "target/zyal/reasoning/${run.id}/repo-graph.json"
+  nodes: [target, replacement, stage, task, files, modules, functions, commands, tests, parity_cases, perf_budgets]
+  edges: [contains, imports, calls, tests, implements, depends_on, phase_owns, task_touches, parity_covers, changed_by, supports, critiques, reduces]
+  feed_workers: true
+
+parity_lab:
+  enabled: true
+  style: target_switched
+  artifact_dir: "target/zyal/parity/${run.id}"
+  cases_dir: "tests/parity/minikv"
+  approved_cases_only: true
+  raw_results: raw.jsonl
+  summary: summary.json
+  gaps: gaps.json
+  adapters:
+    reference:
+      target_kind: minikv
+      repo: "./fixtures/minikv-reference"
+      command: "./fixtures/minikv-reference/minikv --in-memory"
+      read_only: true
+    candidate:
+      target_kind: minikv-rust
+      repo: "."
+      command: "cargo run --bin minikv-rs -- --in-memory"
+  required_tags: [required, approved]
+  perf_budget:
+    default_p95_ms_max_ratio: 1.25
+  fail_on:
+    - zero_cases
+    - missing_required_case
+    - skipped_required_case
+    - failed_case
+    - missing_perf_data
+    - perf_ratio_over_budget
+
+model_policy:
+  routine: jnoccio/routine
+  power: jnoccio/power-winner
+  use_routine_for: [frame, retrieve, phase_brainstorm, verifier, memory_curate, parity_generate]
+  use_power_for: [stage_reduce, critic, perf_close, hard_escalation]
+  record_reliability: true
+  paid_live_calls_default: false
+
+sandbox:
+  workers:
+    isolation: git_worktree
+    root: ".zyal/worktrees/${run.id}"
+    max_workers: 10
+    disjoint_write_scopes_required: true
+  target_repos:
+    default: read_only
+    destructive_operations: deny
+
+workflow:
+  states:
+    - compile_super_plan
+    - seed_durable_plan
+    - capture_target
+    - reference_inventory
+    - repo_graph_risk
+    - architecture_plan
+    - core_surface
+    - feature_semantics
+    - parity_harness
+    - integration_fusion
+    - performance_closure
+    - release_signoff
+    - complete
+  persist: sqlite
+  receipts: "target/zyal/runs/${run.id}/events.jsonl"
+  stop_file: "target/zyal/runs/${run.id}/STOP"
+
+checkpoint:
+  when: after_verified_change
+  noop_if_clean: true
+  verify:
+    - command: "rtk just zyal-superagent-fast"
+      timeout: 30m
+    - command: "rtk git diff --check"
+      timeout: 2m
+  git:
+    add: ["declared_worker_paths_only"]
+    commit_message: "zyal(super-agent): ${task.id}"
+    push: ask
+
+done:
+  require:
+    - target_request_captured
+    - master_plan_generated_from_runtime_evidence
+    - phases_complete
+    - jankurai_gate_passed
+    - parity_gate_passed
+    - perf_budgets_checked
+    - memory_capsules_verified_or_rejected
+  forbid:
+    - model_only_claim
+    - raw_chain_of_thought_storage
+    - missing_required_parity_case
+    - skipped_required_parity_case
+    - unchecked_perf_budget
+<<<END_ZYAL id=super-agent-port-kernel>>>
+ZYAL_ARM RUN_FOREVER id=super-agent-port-kernel
diff --git a/Justfile b/Justfile
