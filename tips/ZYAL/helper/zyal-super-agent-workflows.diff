+
+    fn sample() -> &'static str {
+        r#"
+<<<ZYAL v1:daemon id=redis-jedis-port-foundry>>>
+version: v1
+intent: daemon
+confirm: RUN_FOREVER
+job:
+  name: "Redis to Rust port foundry"
+  objective: "Build a Rust replacement with reference parity."
+port:
+  target: "Redis"
+  replacement: "Jedis"
+  target_repo: "./references/redis"
+  replacement_repo: "."
+  worker_cap: 10
+  stage_strategy: runtime_generated_from_evidence
+advanced_reasoning:
+  enabled: true
+  worker_cap: 10
+  confidence_cap_without_executable_evidence: 0.35
+  store_raw_reasoning: false
+repo_graph:
+  enabled: true
+  store: sqlite
+  nodes: [files, modules, functions, tests, commands, parity_cases]
+  edges: [contains, calls, tests, parity_covers, changed_by]
+parity_lab:
+  enabled: true
+  style: redlinedb
+  fail_on: [zero_cases, missing_required_case, skipped_required_case, failed_case, missing_perf_data, perf_ratio_over_budget]
+  adapters:
+    reference:
+      target_kind: redis
+      command: "./src/redis-server --save '' --appendonly no"
+      read_only: true
+    candidate:
+      target_kind: jedis
+      command: "cargo run --bin jedis"
+workflow:
+  states: [capture_target, brainstorm_stages, finalize_master_plan, complete]
+done:
+  require: [phases_complete, parity_gate_passed]
+  forbid: [model_only_claim]
+<<<END_ZYAL id=redis-jedis-port-foundry>>>
+ZYAL_ARM RUN_FOREVER id=redis-jedis-port-foundry
+"#
+    }
+
+    #[test]
+    fn compiles_redis_like_request_to_ten_stage_plan() {
+        let plan = compile_port_super_plan(sample()).expect("compile");
+        assert_eq!(plan.target.name, "Redis");
+        assert_eq!(plan.replacement.name, "Jedis");
+        assert_eq!(plan.worker_cap, 10);
+        assert_eq!(plan.phases.len(), 10);
+        assert_eq!(plan.phases[0].id, "scope-contract");
+        assert!(plan
+            .phases
+            .iter()
+            .any(|phase| phase.id == "parity-harness"));
+        assert!(!plan.memory.store_raw_reasoning);
+        assert!(plan.parity_lab.enabled);
+    }
+
+    #[test]
+    fn rejects_raw_reasoning_storage() {
+        let body = sample().replace("store_raw_reasoning: false", "store_raw_reasoning: true");
+        let err = compile_port_super_plan(&body).unwrap_err();
+        assert!(format!("{err}").contains("store_raw_reasoning"));
+    }
+
+    #[test]
+    fn rejects_worker_cap_over_hard_limit() {
+        let body = sample().replace("worker_cap: 10", "worker_cap: 21");
+        let err = compile_port_super_plan(&body).unwrap_err();
+        assert!(format!("{err}").contains("worker cap"));
+    }
+
+    #[test]
+    fn plan_hash_is_stable() {
+        let a = compile_port_super_plan(sample()).expect("compile a");
+        let b = compile_port_super_plan(sample()).expect("compile b");
+        assert_eq!(a.plan_hash, b.plan_hash);
+    }
+}
