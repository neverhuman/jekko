+//! Runtime bridge for ZYAL super-agent port workflows.
+//!
+//! The core compiler produces a pure, deterministic plan. This module seeds
+//! that plan into the existing daemon store tables so the host has durable
+//! phases, tasks, reasoning lanes, memory capsules, concepts, and repo-graph
+//! nodes before workers execute.
+
+use jekko_core::zyal_port_super::{CompiledPhase, CompiledPortSuperPlan, CompiledTaskSeed};
+use jekko_store::daemon::{
+    upsert_concept, upsert_concept_link, upsert_memory_capsule, upsert_port_phase,
+    upsert_port_target, upsert_port_task, upsert_reasoning_artifact, upsert_reasoning_edge,
+    upsert_reasoning_lane, upsert_repo_graph_edge, upsert_repo_graph_node, DaemonConceptLinkRow,
+    DaemonConceptRow, MemoryCapsuleRow, PortPhaseRow, PortTargetRow, PortTaskRow,
+    ReasoningArtifactRow, ReasoningEdgeRow, ReasoningLaneRow, RepoGraphEdgeRow,
+    RepoGraphNodeRow,
+};
+use jekko_store::{StoreError, StoreResult};
+use rusqlite::Connection;
+use serde::{Deserialize, Serialize};
+
+/// Receipt emitted after seeding a super-agent plan.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct SuperAgentSeedReceipt {
+    /// Run id.
+    pub run_id: String,
+    /// Stable plan hash.
+    pub plan_hash: String,
+    /// Port target row id.
+    pub target_id: String,
+    /// Number of seeded phases.
+    pub phase_count: usize,
+    /// Number of seeded task rows.
+    pub task_count: usize,
+    /// Number of seeded reasoning lanes.
+    pub lane_count: usize,
+    /// Number of seeded repo graph nodes.
+    pub repo_graph_node_count: usize,
+    /// Number of seeded repo graph edges.
+    pub repo_graph_edge_count: usize,
+    /// Number of initial memory capsules.
+    pub memory_capsule_count: usize,
+}
+
+/// Seed a compiled super-agent plan into the durable daemon tables.
+pub fn seed_super_agent_plan(
+    conn: &Connection,
+    plan: &CompiledPortSuperPlan,
+    now_ms: i64,
+) -> StoreResult<SuperAgentSeedReceipt> {
+    validate_plan(plan)?;
+
+    let target_id = format!("port-target-{}", &plan.plan_hash[..16]);
+    let artifact_id = format!("reasoning-plan-{}", &plan.plan_hash[..16]);
+    let plan_payload = serde_json::to_value(plan)?;
+
+    upsert_port_target(
+        conn,
+        &PortTargetRow {
+            id: target_id.clone(),
+            run_id: plan.run_id.clone(),
+            target: plan.target.name.clone(),
+            replacement: plan.replacement.name.clone(),
+            target_repo: plan.target.repo.clone(),
+            replacement_repo: plan.replacement.repo.clone(),
+            request: plan.objective.clone(),
+            status: "planned".to_string(),
+            current_phase_id: plan.phases.first().map(runtime_phase_id),
+            worker_cap: i64::from(plan.worker_cap),
+            last_audit_score: None,
+            last_parity_report_json: None,
+            last_perf_gap_json: None,
+            rollback_status: "required_when_risky".to_string(),
+            quarantine_status: "clean".to_string(),
+            time_created: now_ms,
+            time_updated: now_ms,
+        },
+    )?;
+
+    upsert_reasoning_artifact(
+        conn,
+        &ReasoningArtifactRow {
+            id: artifact_id.clone(),
+            run_id: plan.run_id.clone(),
+            role: "host".to_string(),
+            kind: "compiled_super_agent_plan".to_string(),
+            title: format!("{} → {} super-agent plan", plan.target.name, plan.replacement.name),
+            summary: format!(
+                "{} phases, {} lanes, worker cap {}",
+                plan.phases.len(),
+                plan.lanes.len(),
+                plan.worker_cap
+            ),
+            evidence_level: "E1".to_string(),
+            confidence: 1.0,
+            payload_json: Some(plan_payload),
+            content_hash: plan.plan_hash.clone(),
+            status: "verified".to_string(),
+            time_created: now_ms,
+            time_updated: now_ms,
+        },
+    )?;
+
+    upsert_memory_capsule(
+        conn,
+        &MemoryCapsuleRow {
+            id: format!("memory-plan-{}", &plan.plan_hash[..16]),
+            run_id: plan.run_id.clone(),
+            artifact_id: artifact_id.clone(),
+            scope: "run".to_string(),
+            status: "verified".to_string(),
+            summary: format!(
+                "Host compiled a {}-phase bounded port plan for {} → {}.",
+                plan.phases.len(),
+                plan.target.name,
+                plan.replacement.name
+            ),
+            evidence_level: "E1".to_string(),
+            confidence: 1.0,
+            payload_json: Some(serde_json::json!({
+                "plan_hash": plan.plan_hash.clone(),
+                "stage_strategy": plan.stage_strategy.clone(),
+                "done": plan.done.clone(),
+                "memory": plan.memory.clone(),
+            })),
+            content_hash: plan.plan_hash.clone(),
+            time_created: now_ms,
+            time_updated: now_ms,
+        },
+    )?;
+
+    let mut task_count = 0;
+    let mut graph_nodes = 0;
+    let mut graph_edges = 0;
+    seed_root_graph(conn, plan, &target_id, now_ms, &mut graph_nodes, &mut graph_edges)?;
+
+    for phase in &plan.phases {
+        let phase_id = runtime_phase_id(phase);
+        upsert_port_phase(conn, &phase_row(plan, phase, &target_id, now_ms)?)?;
+        seed_phase_concept(conn, plan, phase, &artifact_id, now_ms)?;
+        seed_phase_graph(conn, plan, phase, now_ms, &mut graph_nodes, &mut graph_edges)?;
+        for task in &phase.task_seeds {
+            upsert_port_task(conn, &task_row(plan, task, &phase_id, now_ms))?;
+            seed_task_graph(
+                conn,
+                plan,
+                phase,
+                task,
+                now_ms,
+                &mut graph_nodes,
+                &mut graph_edges,
+            )?;
+            task_count += 1;
+        }
+    }
+
+    for lane in &plan.lanes {
+        let lane_artifact = lane_artifact_id(plan, &lane.id);
+        upsert_reasoning_artifact(
+            conn,
+            &ReasoningArtifactRow {
+                id: lane_artifact.clone(),
+                run_id: plan.run_id.clone(),
+                role: lane.role.clone(),
+                kind: "reasoning_lane_seed".to_string(),
+                title: format!("{} lane", lane.role),
+                summary: format!(
+                    "Seeded {} lane with {} strategy and scratch-only writes.",
+                    lane.role, lane.strategy
+                ),
+                evidence_level: "E1".to_string(),
+                confidence: 1.0,
+                payload_json: Some(serde_json::to_value(lane)?),
+                content_hash: plan.plan_hash.clone(),
+                status: "verified".to_string(),
+                time_created: now_ms,
+                time_updated: now_ms,
+            },
+        )?;
+        upsert_reasoning_lane(
+            conn,
+            &ReasoningLaneRow {
+                id: format!("{}-{}", plan.run_id, lane.id),
+                run_id: plan.run_id.clone(),
+                role: lane.role.clone(),
+                strategy: lane.strategy.clone(),
+                status: "ready".to_string(),
+                artifact_ids: vec![artifact_id.clone(), lane_artifact],
+                write_scope: lane.write_scope.clone(),
+                worker_id: None,
+                confidence: 0.0,
+                time_created: now_ms,
+                time_updated: now_ms,
+            },
+        )?;
+    }
+
+    seed_reasoning_edges(conn, plan, &artifact_id, now_ms)?;
+
+    Ok(SuperAgentSeedReceipt {
+        run_id: plan.run_id.clone(),
+        plan_hash: plan.plan_hash.clone(),
+        target_id,
+        phase_count: plan.phases.len(),
+        task_count,
+        lane_count: plan.lanes.len(),
+        repo_graph_node_count: graph_nodes,
+        repo_graph_edge_count: graph_edges,
+        memory_capsule_count: 1,
+    })
+}
+
+fn validate_plan(plan: &CompiledPortSuperPlan) -> StoreResult<()> {
+    if !(9..=12).contains(&plan.phases.len()) {
+        return Err(StoreError::Invalid(format!(
+            "compiled super-agent plan must have 9-12 phases; got {}",
+            plan.phases.len()
+        )));
+    }
+    if plan.worker_cap == 0 || plan.worker_cap > 20 {
+        return Err(StoreError::Invalid(format!(
+            "worker cap must be between 1 and 20; got {}",
+            plan.worker_cap
+        )));
+    }
+    if plan.memory.store_raw_reasoning {
+        return Err(StoreError::Invalid(
+            "super-agent plans may not store raw reasoning".to_string(),
+        ));
+    }
+    Ok(())
+}
+
+fn phase_row(
+    plan: &CompiledPortSuperPlan,
+    phase: &CompiledPhase,
+    target_id: &str,
+    now_ms: i64,
+) -> StoreResult<PortPhaseRow> {
+    Ok(PortPhaseRow {
+        id: runtime_phase_id(phase),
+        run_id: plan.run_id.clone(),
+        target_id: target_id.to_string(),
+        ordinal: i64::from(phase.ordinal),
+        name: phase.name.clone(),
+        status: "pending".to_string(),
+        strategy: phase.strategy.clone(),
+        plan_json: Some(serde_json::to_value(phase)?),
+        task_count: phase.task_seeds.len() as i64,
+        last_audit_score: None,
+        last_parity_report_json: None,
+        time_created: now_ms,
+        time_updated: now_ms,
+    })
+}
+
+fn task_row(
+    plan: &CompiledPortSuperPlan,
+    task: &CompiledTaskSeed,
+    phase_id: &str,
+    now_ms: i64,
+) -> PortTaskRow {
+    PortTaskRow {
+        id: format!("{}-{}", plan.run_id, task.id),
+        run_id: plan.run_id.clone(),
+        phase_id: phase_id.to_string(),
+        title: task.title.clone(),
+        status: "pending".to_string(),
+        worker_id: None,
+        branch: Some(format!("zyal/{}/{}", plan.run_id, task.id)),
+        write_scope: task.write_scope.clone(),
+        proof_lane: Some(task.proof_lane.clone()),
+        attempt_count: 0,
+        rollback_status: "not_started".to_string(),
+        quarantine_reason: None,
+        last_error: None,
+        time_created: now_ms,
+        time_updated: now_ms,
+    }
+}
+
+fn seed_phase_concept(
+    conn: &Connection,
+    plan: &CompiledPortSuperPlan,
+    phase: &CompiledPhase,
+    artifact_id: &str,
+    now_ms: i64,
+) -> StoreResult<()> {
+    let concept_id = format!("phase:{}", phase.id);
+    upsert_concept(
+        conn,
+        &DaemonConceptRow {
+            id: format!("{}-{concept_id}", plan.run_id),
+            run_id: plan.run_id.clone(),
+            concept_id: concept_id.clone(),
+            definition: phase.objective.clone(),
+            derived_from_json: Some(serde_json::json!({
+                "artifact_id": artifact_id,
+                "plan_hash": plan.plan_hash.clone(),
+            })),
+            proof_refs_json: Some(serde_json::json!({
+                "phase_id": phase.id.clone(),
+                "gates": phase.gates.clone(),
+            })),
+            confidence: 1.0,
+            invalidated_at: None,
+            invalidated_reason: None,
+            time_created: now_ms,
+            time_updated: now_ms,
+        },
+    )?;
+    for dep in &phase.depends_on {
+        upsert_concept_link(
+            conn,
+            &DaemonConceptLinkRow {
+                run_id: plan.run_id.clone(),
+                parent_concept: format!("phase:{dep}"),
+                child_concept: concept_id.clone(),
+                relation: "depends_on".to_string(),
+                time_created: now_ms,
+            },
+        )?;
+    }
+    Ok(())
+}
+
+fn seed_root_graph(
+    conn: &Connection,
+    plan: &CompiledPortSuperPlan,
+    target_id: &str,
+    now_ms: i64,
+    node_count: &mut usize,
+    edge_count: &mut usize,
+) -> StoreResult<()> {
+    let target_node = format!("{}:target", plan.run_id);
+    let replacement_node = format!("{}:replacement", plan.run_id);
+    seed_node(
+        conn,
+        plan,
+        &target_node,
+        "target",
+        &plan.target.name,
+        serde_json::json!({ "repo": plan.target.repo.clone(), "port_target_id": target_id }),
+        now_ms,
+        node_count,
+    )?;
+    seed_node(
+        conn,
+        plan,
+        &replacement_node,
+        "replacement",
+        &plan.replacement.name,
+        serde_json::json!({ "repo": plan.replacement.repo.clone(), "port_target_id": target_id }),
+        now_ms,
+        node_count,
+    )?;
+    seed_edge(
+        conn,
+        plan,
+        &target_node,
+        &replacement_node,
+        "replaced_by",
+        serde_json::json!({ "plan_hash": plan.plan_hash.clone() }),
+        now_ms,
+        edge_count,
+    )
+}
+
+fn seed_phase_graph(
+    conn: &Connection,
+    plan: &CompiledPortSuperPlan,
+    phase: &CompiledPhase,
+    now_ms: i64,
+    node_count: &mut usize,
+    edge_count: &mut usize,
+) -> StoreResult<()> {
+    let phase_node = graph_phase_node_id(plan, phase);
+    seed_node(
+        conn,
+        plan,
+        &phase_node,
+        "stage",
+        &phase.name,
+        serde_json::to_value(phase)?,
+        now_ms,
+        node_count,
+    )?;
+    seed_edge(
+        conn,
+        plan,
+        &format!("{}:target", plan.run_id),
+        &phase_node,
+        "scoped_by",
+        serde_json::json!({ "ordinal": phase.ordinal }),
+        now_ms,
+        edge_count,
+    )?;
+    for dep in &phase.depends_on {
+        seed_edge(
+            conn,
+            plan,
+            &format!("{}:phase:{dep}", plan.run_id),
+            &phase_node,
+            "depends_on",
+            serde_json::json!({}),
+            now_ms,
+            edge_count,
+        )?;
+    }
+    Ok(())
+}
+
+fn seed_task_graph(
+    conn: &Connection,
+    plan: &CompiledPortSuperPlan,
+    phase: &CompiledPhase,
+    task: &CompiledTaskSeed,
+    now_ms: i64,
+    node_count: &mut usize,
+    edge_count: &mut usize,
+) -> StoreResult<()> {
+    let task_node = format!("{}:task:{}", plan.run_id, task.id);
+    seed_node(
+        conn,
+        plan,
+        &task_node,
+        "task",
+        &task.title,
+        serde_json::to_value(task)?,
+        now_ms,
+        node_count,
+    )?;
+    seed_edge(
+        conn,
+        plan,
+        &graph_phase_node_id(plan, phase),
+        &task_node,
+        "phase_owns",
+        serde_json::json!({ "proof_lane": task.proof_lane.clone() }),
+        now_ms,
+        edge_count,
+    )
+}
+
+fn seed_reasoning_edges(
+    conn: &Connection,
+    plan: &CompiledPortSuperPlan,
+    artifact_id: &str,
+    now_ms: i64,
+) -> StoreResult<()> {
+    for lane in &plan.lanes {
+        upsert_reasoning_edge(
+            conn,
+            &ReasoningEdgeRow {
+                run_id: plan.run_id.clone(),
+                src_artifact_id: artifact_id.to_string(),
+                dst_artifact_id: lane_artifact_id(plan, &lane.id),
+                kind: "assigned_to_lane".to_string(),
+                weight: Some(1.0),
+                payload_json: Some(serde_json::json!({ "role": lane.role.clone() })),
+                time_created: now_ms,
+            },
+        )?;
+    }
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn seed_node(
+    conn: &Connection,
+    plan: &CompiledPortSuperPlan,
+    id: &str,
+    kind: &str,
+    label: &str,
+    payload: serde_json::Value,
+    now_ms: i64,
+    count: &mut usize,
+) -> StoreResult<()> {
+    upsert_repo_graph_node(
+        conn,
+        &RepoGraphNodeRow {
+            id: id.to_string(),
+            run_id: plan.run_id.clone(),
+            kind: kind.to_string(),
+            key: id.to_string(),
+            label: label.to_string(),
+            payload_json: Some(payload),
+            time_created: now_ms,
+            time_updated: now_ms,
+        },
+    )?;
+    *count += 1;
+    Ok(())
+}
+
+#[allow(clippy::too_many_arguments)]
+fn seed_edge(
+    conn: &Connection,
+    plan: &CompiledPortSuperPlan,
+    src: &str,
+    dst: &str,
+    kind: &str,
+    payload: serde_json::Value,
+    now_ms: i64,
+    count: &mut usize,
+) -> StoreResult<()> {
+    upsert_repo_graph_edge(
+        conn,
+        &RepoGraphEdgeRow {
+            run_id: plan.run_id.clone(),
+            src_node_id: src.to_string(),
+            dst_node_id: dst.to_string(),
+            kind: kind.to_string(),
+            payload_json: Some(payload),
+            time_created: now_ms,
+        },
+    )?;
+    *count += 1;
+    Ok(())
+}
+
+fn runtime_phase_id(phase: &CompiledPhase) -> String {
+    format!("phase-{:02}-{}", phase.ordinal, phase.id)
+}
+
+fn lane_artifact_id(plan: &CompiledPortSuperPlan, lane_id: &str) -> String {
+    format!("{}:lane-artifact:{lane_id}", plan.run_id)
+}
+
+fn graph_phase_node_id(plan: &CompiledPortSuperPlan, phase: &CompiledPhase) -> String {
+    format!("{}:phase:{}", plan.run_id, phase.id)
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use jekko_core::zyal_port_super::compile_port_super_plan;
+    use jekko_store::daemon::{
+        list_memory_capsules_for_run, list_port_phases_for_target, list_port_tasks_for_phase,
+        list_reasoning_lanes_for_run, list_repo_graph_edges_for_run, list_repo_graph_nodes_for_run,
+    };
+    use jekko_store::Db;
+
+    fn sample() -> &'static str {
+        r#"
+version: v1
+intent: daemon
+confirm: RUN_FOREVER
+id: generic-port-workflow-ultra
+job:
+  name: "Generic port workflow"
+  objective: "Build a replacement implementation with reference-target parity."
+port:
+  target: "MiniKV"
+  replacement: "MiniKV Rust"
+  worker_cap: 6
+advanced_reasoning:
+  enabled: true
+  worker_cap: 6
+  store_raw_reasoning: false
+parity_lab:
+  enabled: true
+  fail_on: [zero_cases, missing_required_case, skipped_required_case, failed_case, missing_perf_data]
+"#
+    }
+
+    #[test]
+    fn seeds_plan_into_existing_daemon_tables() {
+        let db = Db::open_in_memory().expect("db");
+        let plan = compile_port_super_plan(sample()).expect("compile");
+        let receipt = seed_super_agent_plan(db.connection(), &plan, 1_777_000_000_000)
+            .expect("seed plan");
+        assert_eq!(receipt.phase_count, 10);
+        assert_eq!(receipt.lane_count, 6);
+        assert_eq!(receipt.memory_capsule_count, 1);
+
+        let phases = list_port_phases_for_target(db.connection(), &receipt.target_id).unwrap();
+        assert_eq!(phases.len(), 10);
+        let tasks = list_port_tasks_for_phase(db.connection(), &phases[0].id).unwrap();
+        assert_eq!(tasks.len(), 4);
+        let lanes = list_reasoning_lanes_for_run(db.connection(), &plan.run_id).unwrap();
+        assert_eq!(lanes.len(), 6);
+        let capsules = list_memory_capsules_for_run(db.connection(), &plan.run_id).unwrap();
+        assert_eq!(capsules.len(), 1);
+        let graph_nodes = list_repo_graph_nodes_for_run(db.connection(), &plan.run_id).unwrap();
+        assert!(graph_nodes.len() >= 2 + plan.phases.len());
+        let graph_edges = list_repo_graph_edges_for_run(db.connection(), &plan.run_id).unwrap();
+        assert!(graph_edges.len() >= plan.phases.len());
+    }
+}
