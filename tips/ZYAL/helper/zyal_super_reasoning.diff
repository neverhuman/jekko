+  default_lane: blind_scout
+  on_no_match: default
+
+fan_out:
+  max_parallel: 12
+  mode: scatter_gather
+  reduce:
+    strategy: synthesize_best
+    require_final_verification: true
+  preserve_failed_lanes_as_negative_memory: true
+
+workflow:
+  type: super_reasoning_phase_dag
+  initial: source_of_truth
