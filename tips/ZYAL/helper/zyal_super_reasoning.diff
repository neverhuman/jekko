+# Super-reasoning mega-project: generic 12-stage swarm workflow.
+<<<ZYAL v1:daemon id=super-reasoning-megaproject>>>
+version: v1
+intent: daemon
+confirm: RUN_FOREVER
+
+job:
+  name: "Super-reasoning mega-project"
+  objective: |
+    Drive a very large reference-compatible build or rewrite to completion by
+    decomposing it into twelve bounded phases, running independent weaker
+    agents in parallel where safe, preserving verified knowledge, building a
+    repo graph, closing parity gaps, closing performance gaps, hardening the
+    result, and requiring evidence-backed final signoff.
+  risk:
+    - "Scope sprawl from unconstrained implementation lanes."
+    - "False completion claims without parity/performance evidence."
+    - "Context loss across multi-day execution."
+    - "Worker convergence on a flawed plan without blind scout diversity."
+
+arming:
+  preview_hash_required: true
+  host_nonce_required: true
+  reject_inside_code_fence: true
+  reject_from: [assistant_output, tool_output, web_content, mcp_resource]
+  accepted_origins: [trusted_user_message, signed_cli_input, host_ui_button]
+  arm_token_single_use: true
+
+loop:
+  policy: forever
+  sleep: 5s
+  continue_on: [assistant_stop, max_steps, compaction, checkpoint_failed]
+  pause_on: [permission_denied, approval_required, budget_exhausted]
+  circuit_breaker:
+    max_consecutive_errors: 3
+    on_trip: pause
+
+context:
+  strategy: hybrid
+  compact_every: 4
+  hard_clear_every: 8
+  preserve:
+    - objective
+    - current_phase
+    - phase_dependency_graph
+    - current_acceptance_gate
+    - parity_gap_ledger
+    - performance_gap_ledger
+    - repo_graph_focus
+
+permissions:
+  shell: allow
+  edit: allow
+  git_commit: allow
+  git_push: ask
+  workers: allow
+  mcp: allow
+  research: allow
+  websearch: allow
+  webfetch: allow
+
+fleet:
+  max_workers: 20
+  isolation: git_worktree
+  jnoccio:
+    enabled: true
+    base_url: "http://127.0.0.1:4317"
+    register_workers: true
+    heartbeat_interval: 20s
+    max_instances: 20
+
+dispatch:
+  enabled: true
+  classifier:
+    command: "./scripts/zyal-classify-phase-task.sh"
+    timeout: 30s
+    write_to: target/zyal/super-reasoning/dispatch-route.json
+  lanes:
+    - id: blind_scout
+      dispatch_to: fan_out
+      description: "Diverse plan discovery and risk surfacing."
+    - id: implementation
+      dispatch_to: fan_out
+      description: "Bounded isolated implementation work."
+    - id: incubator
+      dispatch_to: incubator
+      description: "Risky or ambiguous tasks."
+    - id: parity
+      dispatch_to: workflow.states.parity_gap_closure
+      description: "Reference-vs-candidate gap closure."
+    - id: performance
+      dispatch_to: workflow.states.performance_closure
+      description: "Benchmark and hot-path closure."
