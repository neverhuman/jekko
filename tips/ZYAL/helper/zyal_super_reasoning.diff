+      writes: scratch_only
+    - id: strengthen
+      type: strengthen
+      context: inherit
+      reads: [current_best]
+      writes: scratch_only
+    - id: critique
+      type: critic
+      context: pool
+      reads: [candidate_pool]
+      writes: scratch_only
+    - id: prototype
+      type: prototype
+      context: inherit
+      reads: [current_best]
+      writes: isolated_worktree
+    - id: review
+      type: promotion_review
+      context: promotion
+      reads: [current_best]
+      writes: scratch_only
+
+evidence:
+  require_before_promote:
+    - type: phase_receipt
+      must_exist: true
+      must_pass: true
+    - type: tests
+      must_exist: true
+      must_pass: true
+    - type: parity
+      must_exist: true
+      must_pass: true
+    - type: performance
+      must_be_known: true
+  bundle_format: json
+  sign: sha256
+  archive: true
+
+approvals:
+  gates:
+    phase_review:
+      required_role: reviewer
+      timeout: 12h
+      decisions: [approve, reject]
+      require_evidence: [phase_receipt, proof_log]
+    final_review:
+      required_role: reviewer
+      timeout: 24h
+      decisions: [approve, reject]
+      require_evidence: [final_receipt, parity_closure, performance_closure, hardening_receipt]
+
+budgets:
+  run:
+    wall_clock: 14d
+    cost_usd: 250.00
+    on_exhaust: renew_with_approval
+  task:
+    iterations: 12
+    cost_usd: 8.00
+    on_exhaust: park
+  iteration:
+    tool_calls: 80
+    diff_lines: 1200
+    on_exhaust: pause
+
+quality:
+  anti_vibe:
+    enabled: true
+    fail_closed: true
+    block_test_deletion: true
+    block_assertion_weakening: true
+    block_silent_catch: true
+    block_fake_data_substitutes: true
+    require_root_cause_for_bugfix: true
+    require_failing_test_first_for_bugfix: true
+  diff_budget:
+    max_files_changed: 80
+    max_added_lines: 8000
+    on_violation: require_approval
+
+sandbox:
+  paths:
+    - path: ".jekko/sandboxes/super-reasoning-megaproject/**"
+      access: read_write
+    - path: "/dev/shm/jekko-parity/**"
+      access: read_write
+  network:
+    outbound: allowlist
+    allowlist: ["github.com", "raw.githubusercontent.com", "docs.rs"]
+  resources:
+    max_memory: 32G
+    max_processes: 512
+    max_total_disk: 200G
+  env_deny: ["*_TOKEN", "*_SECRET", "*_KEY"]
+
+security:
+  injection:
+    scan_inputs: true
+    scan_outputs: true
+    deny_patterns:
+      - "(?i)ignore previous instructions"
+      - "(?i)reveal secrets"
+      - "(?i)system prompt"
+    on_detect: block
+  secrets:
+    allowed_env: []
+    redact_from_logs: true
+
+observability:
+  spans:
+    emit: sqlite
+    include_tool_calls: true
+    include_model_calls: true
+  metrics:
+    - name: ready_phases
+      type: gauge
+      source: daemon.super_reasoning.ready_phase_ids
+    - name: open_parity_gaps
+      type: gauge
+      source: .jekko/memory/parity-gaps
+    - name: open_performance_gaps
+      type: gauge
+      source: .jekko/memory/performance-gaps
+  report:
+    format: markdown
+    on_complete: true
+    on_checkpoint: true
+    include: [phase_dag, worker_receipts, memory_summary, repo_graph_delta, parity_gaps, perf_gaps]
+
+checkpoint:
+  when: after_verified_change
+  noop_if_clean: true
+  verify:
+    - command: "./scripts/phase-proof.sh current"
+      timeout: 90m
+    - command: "git diff --check"
+      timeout: 2m
+  git:
+    add: ["."]
+    commit_message: "zyal(super): ${workflow.state} ${task.id}"
+    push: ask
+
+rollback:
+  strategy: revert_last_checkpoint
+  verify_after_rollback:
+    - command: "./scripts/smoke.sh"
+      timeout: 20m
+
+stop:
+  all:
+    - shell:
+        command: "test -f .jekko/daemon-stop"
+        timeout: 10m
+    - git_clean:
+        allow_untracked: false
+
+done:
+  require:
+    - stop_conditions_met
+    - evidence_complete
+    - all_workflow_states_terminal
+    - parity_gaps_zero
+    - performance_budget_met
+  forbid:
+    - model_only_claim
+    - tests_not_run
+    - open_critical_objections
+
+ui:
+  theme: jekko-gold
+  banner: forever
+<<<END_ZYAL id=super-reasoning-megaproject>>>
+ZYAL_ARM RUN_FOREVER id=super-reasoning-megaproject
