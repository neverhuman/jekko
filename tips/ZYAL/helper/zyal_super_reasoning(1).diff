+/// Create a verified/rejected memory capsule for a phase result.  This is safe
+/// to persist through `daemon_store::persist_memory_capsule`; it stores only
+/// structured summaries and payload hashes.
+pub fn phase_memory_capsule(
+    run_id: &str,
+    stage: &PortStage,
+    status: &str,
+    summary: impl Into<String>,
+    payload_json: Value,
+) -> MemoryCapsule {
+    let status = if status == "rejected" {
+        "rejected"
+    } else {
+        "verified"
+    };
+    let summary = summary.into();
+    let payload = json!({
+        "stage_id": stage.id.clone(),
+        "stage_name": stage.name.clone(),
+        "status": status,
+        "payload": payload_json,
+    });
+    let content_hash = stable_reasoning_hash(&json!({
+        "run_id": run_id,
+        "stage_id": stage.id.clone(),
+        "status": status,
+        "summary": summary.clone(),
+        "payload": payload.clone(),
+    }));
+    MemoryCapsule {
+        id: format!("memory-{run_id}-{}", stage.id),
+        run_id: run_id.to_string(),
+        artifact_id: stage.id.clone(),
+        scope: "phase".to_string(),
+        status: status.to_string(),
+        summary,
+        evidence_level: EvidenceLevel::ExternalGrounding,
+        confidence: 0.7,
+        payload_json: payload,
+        content_hash,
+    }
+}
