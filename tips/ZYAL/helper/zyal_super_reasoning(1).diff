+/// Validate the macro-plan shape before persisting or fusing work.
+pub fn validate_super_macro_plan(
+    plan: &PortMasterPlan,
+    config: &SuperReasoningConfig,
+) -> Result<()> {
+    if !config.enabled {
+        return Ok(());
+    }
+    let count = plan.stages.len();
+    if !(SUPER_STAGE_MIN..=SUPER_STAGE_MAX).contains(&count) {
+        return Err(anyhow!(
+            "super reasoning macro plan must contain {SUPER_STAGE_MIN}-{SUPER_STAGE_MAX} stages, got {count}"
+        ));
+    }
+    let mut ordinals = BTreeSet::new();
+    for stage in &plan.stages {
+        if !ordinals.insert(stage.ordinal) {
+            return Err(anyhow!("duplicate macro-stage ordinal {}", stage.ordinal));
+        }
+        let stage_tasks: Vec<&PortMasterTask> = plan
+            .tasks
+            .iter()
+            .filter(|task| task.stage_id == stage.id)
+            .collect();
+        if stage_tasks.is_empty() {
+            return Err(anyhow!("macro-stage {} has no tasks", stage.id));
+        }
+        for task in stage_tasks {
+            if task.write_scope.is_empty() {
+                return Err(anyhow!("task {} has no declared write scope", task.id));
+            }
+            if task.proof_lane.trim().is_empty() {
+                return Err(anyhow!("task {} has no proof lane", task.id));
+            }
+        }
+    }
+    Ok(())
+}
