+/// Required gates before a phase can be marked complete or fused.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct PhaseSignoffPolicy {
+    /// Reducer must synthesize lane outputs.
+    #[serde(default = "default_true")]
+    pub require_reducer: bool,
+    /// Verifier must approve claims and evidence.
+    #[serde(default = "default_true")]
+    pub require_verifier: bool,
+    /// Jankurai hard/regression gate must pass.
+    #[serde(default = "default_true")]
+    pub require_jankurai: bool,
+    /// Parity deltas must be recorded even before full parity closure.
+    #[serde(default = "default_true")]
+    pub require_parity_delta: bool,
+    /// Maximum unresolved critical objections.
+    #[serde(default)]
+    pub max_unresolved_objections: usize,
+}
+
+impl Default for PhaseSignoffPolicy {
+    fn default() -> Self {
+        Self {
+            require_reducer: true,
+            require_verifier: true,
+            require_jankurai: true,
+            require_parity_delta: true,
+            max_unresolved_objections: 0,
+        }
+    }
+}
