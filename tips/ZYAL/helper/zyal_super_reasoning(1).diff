+fn write_scope_for_stage(slug: &str) -> Vec<String> {
+    match slug {
+        "contract-capture" | "evidence-map" => vec![
+            "docs/**".to_string(),
+            "target/zyal/**".to_string(),
+            ".jankurai/**".to_string(),
+        ],
+        "reference-harness" | "parity-expansion" => vec![
+            "tests/parity/**".to_string(),
+            "target/zyal/parity/**".to_string(),
+            "crates/**/tests/**".to_string(),
+        ],
+        "performance-closure" => vec![
+            "benches/**".to_string(),
+            "target/zyal/parity/**".to_string(),
+            "target/zyal/perf/**".to_string(),
+        ],
+        "release-signoff" => vec![
+            "target/zyal/**".to_string(),
+            "docs/**".to_string(),
+            ".jankurai/**".to_string(),
+        ],
+        _ => vec![
+            "src/**".to_string(),
+            "crates/**".to_string(),
+            "tests/**".to_string(),
+            "target/zyal/**".to_string(),
+        ],
+    }
+}
+
+fn proof_lane_for_stage(slug: &str) -> String {
+    match slug {
+        "contract-capture" | "evidence-map" => "rtk git diff --check".to_string(),
+        "reference-harness" | "parity-expansion" => "rtk just zyal-port-fast && rtk git diff --check".to_string(),
+        "performance-closure" => "rtk just zyal-port-fast".to_string(),
+        "release-signoff" => "rtk just zyal-port-fast && rtk jankurai audit . --mode advisory --json .jankurai/repo-score.json --md .jankurai/repo-score.md".to_string(),
+        _ => "rtk just zyal-port-fast && rtk git diff --check".to_string(),
+    }
+}
+
+fn signoff_lane_for_stage(slug: &str, dependencies: &[&str]) -> String {
+    let dep_fragment = if dependencies.is_empty() {
+        "[]".to_string()
+    } else {
+        format!("{dependencies:?}")
+    };
+    format!(
+        "rtk jankurai audit . --mode advisory --json .jankurai/repo-score.json --md .jankurai/repo-score.md # phase={slug} deps={dep_fragment}"
+    )
+}
+
+fn memory_scopes(policy: &ActiveMemoryPolicy) -> Vec<String> {
+    let mut scopes = Vec::new();
+    if policy.episodic {
+        scopes.push("episodic".to_string());
+    }
+    if policy.semantic {
+        scopes.push("semantic".to_string());
+    }
+    if policy.procedural {
+        scopes.push("procedural".to_string());
+    }
+    if policy.negative {
+        scopes.push("negative".to_string());
+    }
+    scopes
+}
