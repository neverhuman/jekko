@@ -0,0 +1,166 @@
+# Generic super-reasoning port foundry.  This is intentionally not Redis-specific:
+# the target/replacement names may describe any ambitious rewrite or parity port.
+<<<ZYAL v1:daemon id=super-port-foundry>>>
+version: v1
+intent: daemon
+confirm: RUN_FOREVER
+
+job:
+  name: "Super port foundry"
+  objective: |
+    Build a replacement implementation with reference-target parity by first
+    producing a 9-12 stage macro plan, then executing phase tasks through a
+    bounded swarm of workers, fusing verified branches, and closing correctness
+    and performance gaps with target-switched parity evidence.
+  risk:
+    - "Do not hard-code target-specific stages in this runbook."
+    - "Do not accept model-only claims."
+    - "Do not copy reference implementation text."
+    - "Do not let worker branches sprawl outside declared write scopes."
+
+port:
+  target: "ReferenceSystem"
+  replacement: "CandidateSystem"
+  target_repo: "./references/reference-system"
+  replacement_repo: "."
+  worker_cap: 10
+  resume_store: sqlite
+  require_clean_start: true
+  stage_strategy: evidence_derived_super_plan
+  stop_on:
+    - dirty_primary_worktree
+    - destructive_target_repo_operation
+    - live_budget_expired
+    - jankurai_hard_regression
+    - repeated_worker_quarantine
+
+super_reasoning:
+  enabled: true
+  macro_stage_target: 10
+  parallel_phases:
+    enabled: true
+    max_parallel_phases: 3
+    require_dependency_edges: true
+    disjoint_write_scopes_required: true
+  active_memory:
+    episodic: true
+    semantic: true
+    procedural: true
+    negative: true
+    max_context_tokens: 24000
+    write_requires:
+      - verified_or_rejected_status
+      - source_artifact_hash
+      - verifier_or_reducer_approval
+      - no_raw_chain_of_thought
+  graph:
+    store: sqlite
+    incremental: true
+    feed_workers: true
+    slice_node_budget: 256
+    include_tests: true
+    include_callers: true
+    include_callees: true
+  parity:
+    required_case_tags: [required, approved]
+    gap_task_prefix: parity-gap
+    require_perf_data: true
+    prefer_ramdisk: true
+    default_p95_ms_max_ratio: 1.25
+  sandbox:
+    run_root: ".zyal/runs/${run.id}"
+    worktree_root: ".zyal/worktrees/${run.id}"
+    keep_between_ticks: true
+    gc_after: 14d
+    read_only_reference_repos: true
+  signoff:
+    require_reducer: true
+    require_verifier: true
+    require_jankurai: true
+    require_parity_delta: true
+    max_unresolved_objections: 0
+
+advanced_reasoning:
+  enabled: true
+  worker_cap: 10
+  confidence_cap: 0.35
+  store_raw_reasoning: false
+  allow_power_for_routine_roles: false
+
+repo_graph:
+  enabled: true
+  store: sqlite
+  export: "target/zyal/reasoning/${run.id}/reasoning-graph.json"
+  nodes: [files, docs, tests, modules, functions, structs, enums, impls, methods, commands, parity_cases, phases, tasks, memory_capsules]
+  edges: [contains, imports, calls, tests, derives_from, parity_covers, phase_owns, changed_by, supports, critiques, reduces]
+  feed_workers: true
+
+parity_lab:
+  enabled: true
+  style: redline
+  artifact_dir: "target/zyal/parity/${run.id}"
+  cases_dir: "tests/parity/reference-system"
+  approved_cases_only: true
+  prefer_ramdisk: true
+  generated_manifest: generated_manifest.json
+  approved_ci: approved-ci.txt
+  raw_results: raw.jsonl
+  summary: summary.json
+  gaps: gaps.json
+  required_tags: [required, approved]
+  perf_budget:
+    default_p95_ms_max_ratio: 1.25
+  fail_on:
+    - zero_cases
+    - missing_required_case
+    - skipped_required_case
+    - failed_case
+    - missing_perf_data
+    - perf_ratio_over_budget
+
+jankurai_gate:
+  command: "rtk jankurai audit . --mode advisory --json .jankurai/repo-score.json --md .jankurai/repo-score.md"
+  max_new_hard_findings: 0
+  max_score_drop: 0
+  block_cap_regression: true
+
+sandbox:
+  workers:
+    isolation: git_worktree
+    root: ".zyal/worktrees/${run.id}"
+    max_workers: 10
+    disjoint_write_scopes_required: true
+  target_repos:
+    default: read_only
+    destructive_operations: deny
+
+fleet:
+  max_workers: 10
+  heartbeat_interval: 20s
+  jnoccio:
+    enabled: true
+    register_workers: true
+    max_instances: 10
+
+model_policy:
+  routine_model: jnoccio/routine
+  power_model: jnoccio/power-winner
+  allow_power_for_routine_roles: false
+
+workflow:
+  states:
+    - capture_target
+    - frame_request
+    - retrieve_context
+    - brainstorm_stages
+    - critique_stages
+    - finalize_master_plan
+    - track_stage
+    - brainstorm_phase
+    - finalize_phase_plan
+    - build_phase
+    - verify_phase
+    - heal_integration
+    - generate_parity
+    - close_parity_perf
+    - complete
+  persist: sqlite
+  receipts: "target/zyal/runs/${run.id}/events.jsonl"
+  stop_file: "target/zyal/runs/${run.id}/STOP"
+
+done:
+  require:
+    - target_request_captured
+    - macro_plan_has_9_to_12_stages
+    - phase_signoffs_complete
+    - verified_memory_capsules_written
+    - reasoning_graph_exported
+    - parity_gate_passed
+    - perf_budgets_checked
+    - jankurai_gate_passed
+  forbid:
+    - model_only_claim
+    - raw_chain_of_thought_storage
+    - copied_reference_implementation
+    - missing_required_parity_case
+    - skipped_required_parity_case
+    - unchecked_perf_budget
+<<<END_ZYAL id=super-port-foundry>>>
+ZYAL_ARM RUN_FOREVER id=super-port-foundry
