+/// Context contract emitted to worker lanes.  This keeps weaker agents scoped:
+/// they get relevant graph slices, verified memory, and a write scope, but not
+/// arbitrary project sprawl or raw private reasoning.
+#[derive(Debug, Clone, PartialEq, Eq, Serialize, Deserialize)]
+pub struct WorkerContextContract {
+    /// Task id.
+    pub task_id: String,
+    /// Phase id.
+    pub phase_id: String,
+    /// Graph node budget.
+    pub graph_node_budget: usize,
+    /// Memory token budget.
+    pub memory_token_budget: usize,
+    /// Memory scopes to fetch.
+    pub memory_scopes: Vec<String>,
+    /// Declared write scope.
+    pub write_scope: Vec<String>,
+    /// Whether raw private reasoning is forbidden.
+    pub forbid_raw_reasoning: bool,
+}
+
+struct StageTemplate {
+    slug: &'static str,
+    name: &'static str,
+    objective: &'static str,
+    parallel_after: &'static [&'static str],
+}
