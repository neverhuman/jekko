+/// Build a generic 9-12 stage master plan.  The names are deliberately domain
+/// neutral; target-specific content belongs in the `objective`, generated
+/// evidence payloads, and phase plans.
+pub fn draft_super_master_plan(
+    target: PortTargetRequest,
+    config: &SuperReasoningConfig,
+) -> PortMasterPlan {
+    let stage_count = config.effective_stage_target();
+    let templates = macro_stage_templates();
+    let replacement = target.replacement.clone();
+    let target_name = target.target.clone();
+
+    let mut stages = Vec::with_capacity(stage_count);
+    let mut tasks = Vec::with_capacity(stage_count * 2);
+    for (idx, template) in templates.into_iter().take(stage_count).enumerate() {
+        let stage_id = format!("stage-{:02}-{}", idx + 1, template.slug);
+        stages.push(PortStage {
+            id: stage_id.clone(),
+            ordinal: idx + 1,
+            name: template.name.to_string(),
+            objective: format!(
+                "{} for {} -> {}. {}",
+                template.name, target_name, replacement, template.objective
+            ),
+            status: if idx == 0 {
+                PhaseStatus::Drafting
+            } else {
+                PhaseStatus::Planned
+            },
+        });
+        tasks.push(PortMasterTask {
+            id: format!("task-{:02}-{}-execute", idx + 1, template.slug),
+            stage_id: stage_id.clone(),
+            title: format!("Execute {} for {}", template.name, replacement),
+            write_scope: write_scope_for_stage(template.slug),
+            proof_lane: proof_lane_for_stage(template.slug),
+            status: MasterTaskStatus::Queued,
+        });
+        tasks.push(PortMasterTask {
+            id: format!("task-{:02}-{}-signoff", idx + 1, template.slug),
+            stage_id,
+            title: format!("Sign off {} with reducer, verifier, Jankurai, and parity receipts", template.name),
+            write_scope: vec![
+                "target/zyal/**".to_string(),
+                ".jankurai/**".to_string(),
+                "tests/parity/**".to_string(),
+            ],
+            proof_lane: signoff_lane_for_stage(template.slug, template.parallel_after),
+            status: MasterTaskStatus::Queued,
+        });
+    }
+
+    PortMasterPlan {
+        target,
+        stages,
+        tasks,
+    }
+}
