+            objective: "Index docs, source, tests, examples, public contracts, and existing benchmark artifacts.",
+            parallel_after: &["contract-capture"],
+        },
+        StageTemplate {
+            slug: "reference-harness",
+            name: "Reference harness",
+            objective: "Build target-switched harnesses and approved manifests before implementation claims.",
+            parallel_after: &["contract-capture"],
