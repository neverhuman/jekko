+/// Build the context contract that should be attached to a worker assignment.
+pub fn worker_context_contract(
+    task: &PortMasterTask,
+    config: &SuperReasoningConfig,
+) -> WorkerContextContract {
+    WorkerContextContract {
+        task_id: task.id.clone(),
+        phase_id: task.stage_id.clone(),
+        graph_node_budget: config.graph.slice_node_budget,
+        memory_token_budget: config.active_memory.max_context_tokens,
+        memory_scopes: memory_scopes(&config.active_memory),
+        write_scope: task.write_scope.clone(),
+        forbid_raw_reasoning: true,
+    }
+}
