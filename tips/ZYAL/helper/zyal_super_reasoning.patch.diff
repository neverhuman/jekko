+//! Manifest model for ZYAL SuperWorkflow JSON.
+
+use std::collections::BTreeMap;
+
+use serde::{Deserialize, Serialize};
+
+/// Top-level SuperWorkflow manifest emitted by `zyalc target=superworkflow`.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SuperWorkflowManifest {
+    /// Runtime sentinel. Currently `v1`.
+    pub version: String,
+    /// ZYAL intent. SuperWorkflows are daemon-oriented.
+    pub intent: String,
+    /// Confirmation literal. Long-running workflows require explicit forever confirmation.
+    pub confirm: String,
+    /// Stable runbook id.
+    pub id: String,
+    /// Job framing.
+    pub job: Job,
+    /// SuperWorkflow orchestration block.
+    pub superworkflow: SuperWorkflow,
+}
+
+/// Human-readable job framing.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Job {
+    /// Human-readable name.
+    pub name: String,
+    /// Objective text.
+    pub objective: String,
+    /// Risk notes.
+    #[serde(default)]
+    pub risk: Vec<String>,
+}
+
+/// SuperWorkflow orchestration contract.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct SuperWorkflow {
+    /// Declared phase count. Must match `phases.len()` when present.
+    #[serde(default)]
+    pub stage_count: Option<usize>,
+    /// High-level strategy label.
+    #[serde(default)]
+    pub strategy: String,
+    /// Controller policy.
+    #[serde(default)]
+    pub controller: ControllerPolicy,
+    /// Active memory policy.
+    #[serde(default)]
+    pub memory: MemoryPolicy,
+    /// Persistent sandbox policy.
+    #[serde(default)]
+    pub sandbox: SandboxPolicy,
+    /// Repo graph policy.
+    #[serde(default)]
+    pub repo_graph: RepoGraphPolicy,
+    /// Parity/differential testing policy.
+    #[serde(default)]
+    pub parity: ParityPolicy,
+    /// Macro phases. Must contain 9-12 phases.
+    pub phases: Vec<Phase>,
+}
+
+/// Supervisor execution policy.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ControllerPolicy {
+    /// Controller mode, e.g. `supervisor_dag`.
+    #[serde(default)]
+    pub mode: String,
+    /// Maximum ready phases allowed to run at once.
+    #[serde(default)]
+    pub max_parallel_phases: Option<u32>,
+    /// Maximum tasks per phase allowed to run at once.
+    #[serde(default)]
+    pub max_parallel_tasks_per_phase: Option<u32>,
+    /// Require explicit sign-off before completing a phase.
+    #[serde(default)]
+    pub require_phase_signoff: bool,
+    /// Retry until all exit gates pass.
+    #[serde(default)]
+    pub retry_until_exit_gates_pass: bool,
+    /// Park unresolved tasks with summary instead of dropping them.
+    #[serde(default)]
+    pub park_unresolved_tasks_with_summary: bool,
+    /// Enable touched-file/task-scope sprawl checks.
+    #[serde(default)]
+    pub prevent_scope_sprawl: bool,
+}
+
+/// Active memory policy.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct MemoryPolicy {
+    /// Path to append-only run WAL.
+    #[serde(default)]
+    pub run_wal: String,
+    /// Glob/path pattern for phase summaries.
+    #[serde(default)]
+    pub phase_summaries: String,
+    /// Durable knowledge store path.
+    #[serde(default)]
+    pub knowledge_store: String,
+    /// Preserve negative lessons and failed plans.
+    #[serde(default)]
+    pub negative_memory: bool,
+    /// Memory classes injected at phase start.
+    #[serde(default)]
+    pub inject_at_phase_start: Vec<String>,
+    /// Task compaction cadence.
+    #[serde(default)]
+    pub compact_every_tasks: Option<u32>,
+}
+
+/// Sandbox policy.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct SandboxPolicy {
+    /// Sandbox mode.
+    #[serde(default)]
+    pub mode: String,
+    /// Workspace root template.
+    #[serde(default)]
+    pub workspace_root: String,
+    /// Isolation backend.
+    #[serde(default)]
+    pub isolation: String,
+    /// Preserve workspace across phases.
+    #[serde(default)]
+    pub preserve_between_phases: bool,
+    /// Export a patch per task.
+    #[serde(default)]
+    pub export_patch_per_task: bool,
+    /// Destroy unmerged worktrees after archival.
+    #[serde(default)]
+    pub destroy_unmerged_worktrees_after_archive: bool,
+}
+
+/// Repo graph policy.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct RepoGraphPolicy {
+    /// Backend, e.g. sqlite.
+    #[serde(default)]
+    pub backend: String,
+    /// Graph database path.
+    #[serde(default)]
+    pub path: String,
+    /// Index categories.
+    #[serde(default)]
+    pub indexes: Vec<String>,
+    /// Refresh triggers.
+    #[serde(default)]
+    pub refresh_on: Vec<String>,
+}
+
+/// Parity/differential testing policy.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct ParityPolicy {
+    /// Enable parity harness support.
+    #[serde(default)]
+    pub enabled: bool,
+    /// Reference adapter path/command.
+    #[serde(default)]
+    pub reference_adapter: String,
+    /// Candidate adapter path/command.
+    #[serde(default)]
+    pub candidate_adapter: String,
+    /// Evidence JSONL path.
+    #[serde(default)]
+    pub evidence_jsonl: String,
+    /// Temporary execution mode, e.g. ramdisk_or_memory.
+    #[serde(default)]
+    pub tmp_mode: String,
+    /// Cluster failures into actionable buckets.
+    #[serde(default)]
+    pub cluster_failures: bool,
+    /// Promote fixed parity gaps into regression tests.
+    #[serde(default)]
+    pub promote_fixed_gap_to_regression: bool,
+}
+
+/// Macro phase definition.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Phase {
+    /// Stable phase id.
+    pub id: String,
+    /// Human-readable phase name.
+    pub name: String,
+    /// Objective text.
+    pub objective: String,
+    /// Phase ids that must complete before this phase can run.
+    #[serde(default)]
+    pub depends_on: Vec<String>,
+    /// Optional parallel group label.
+    #[serde(default)]
+    pub parallel_group: String,
+    /// Agent-role counts.
+    #[serde(default)]
+    pub agents: BTreeMap<String, u32>,
+    /// Optional phase budget.
+    #[serde(default)]
+    pub budget: PhaseBudget,
+    /// Exit contract.
+    pub exit: ExitPlan,
+}
+
+/// Phase budget.
+#[derive(Debug, Clone, Default, Serialize, Deserialize)]
+pub struct PhaseBudget {
+    /// Maximum wall-clock duration label, e.g. `12h`.
+    #[serde(default)]
+    pub max_wall_time: String,
+    /// Maximum attempts.
+    #[serde(default)]
+    pub max_attempts: Option<u32>,
+    /// Maximum accepted touched files.
+    #[serde(default)]
+    pub max_touched_files: Option<u32>,
+}
+
+/// Exit plan for a phase.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct ExitPlan {
+    /// Required artifacts before a phase can close.
+    #[serde(default)]
+    pub required_artifacts: Vec<String>,
+    /// Machine/human gates.
+    #[serde(default)]
+    pub gates: Vec<Gate>,
+    /// Required sign-off roles.
+    #[serde(default)]
+    pub signoff: Vec<String>,
+}
+
+/// Flexible gate payload. `kind` selects semantics; extra keys are kept.
+#[derive(Debug, Clone, Serialize, Deserialize)]
+pub struct Gate {
+    /// Gate kind, e.g. `shell`, `parity_pass_rate`, `review_quorum`.
+    pub kind: String,
+    /// Extra gate parameters.
+    #[serde(flatten)]
+    pub params: BTreeMap<String, serde_json::Value>,
+}
+
+/// Persisted phase status.
+#[derive(Debug, Clone, Copy, PartialEq, Eq, Serialize, Deserialize)]
+#[serde(rename_all = "snake_case")]
+pub enum PhaseStatus {
+    /// Phase is not ready because dependencies remain.
+    Pending,
+    /// Phase dependencies are complete and it can be scheduled.
+    Ready,
+    /// Phase is actively running.
+    Running,
+    /// Phase is blocked.
+    Blocked,
+    /// Phase awaits sign-off/review.
+    Review,
+    /// Phase completed all gates and sign-offs.
+    Complete,
+    /// Phase was parked with summary and follow-up tasks.
+    Parked,
+    /// Phase failed irrecoverably.
+    Failed,
+}
+
+impl PhaseStatus {
+    /// Stable storage string.
+    pub fn as_str(self) -> &'static str {
+        match self {
+            PhaseStatus::Pending => "pending",
+            PhaseStatus::Ready => "ready",
+            PhaseStatus::Running => "running",
+            PhaseStatus::Blocked => "blocked",
+            PhaseStatus::Review => "review",
+            PhaseStatus::Complete => "complete",
+            PhaseStatus::Parked => "parked",
+            PhaseStatus::Failed => "failed",
+        }
+    }
+
+    /// Parse from storage string.
+    pub fn parse(value: &str) -> Option<Self> {
+        Some(match value {
+            "pending" => PhaseStatus::Pending,
+            "ready" => PhaseStatus::Ready,
+            "running" => PhaseStatus::Running,
+            "blocked" => PhaseStatus::Blocked,
+            "review" => PhaseStatus::Review,
+            "complete" => PhaseStatus::Complete,
+            "parked" => PhaseStatus::Parked,
+            "failed" => PhaseStatus::Failed,
+            _ => return None,
+        })
+    }
+}
