new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/crates/zyal-supervisor/src/planner.rs
@@ -0,0 +1,277 @@
+//! Phase-DAG validation and readiness helpers.
+
+use std::collections::{BTreeMap, BTreeSet, VecDeque};
+
+use thiserror::Error;
+
+use crate::model::{Phase, SuperWorkflowManifest};
+
+/// Validation errors for SuperWorkflow manifests.
+#[derive(Debug, Error, PartialEq, Eq)]
+pub enum ValidationError {
+    /// Invalid required top-level literal.
+    #[error("expected {field}={expected:?}, got {actual:?}")]
+    InvalidLiteral {
+        /// Field name.
+        field: &'static str,
+        /// Expected value.
+        expected: &'static str,
+        /// Actual value.
+        actual: String,
+    },
+    /// The phase count must be between 9 and 12.
+    #[error("superworkflow requires 9-12 phases, got {0}")]
+    InvalidPhaseCount(usize),
+    /// Declared stage_count does not match actual phases.
+    #[error("stage_count={declared} does not match phases.len()={actual}")]
+    StageCountMismatch {
+        /// Declared count.
+        declared: usize,
+        /// Actual count.
+        actual: usize,
+    },
+    /// Duplicate phase id.
+    #[error("duplicate phase id {0}")]
+    DuplicatePhaseId(String),
+    /// A dependency references an unknown phase.
+    #[error("phase {phase_id} depends on unknown phase {depends_on}")]
+    UnknownDependency {
+        /// Phase id.
+        phase_id: String,
+        /// Missing dependency.
+        depends_on: String,
+    },
+    /// A phase depends on itself.
+    #[error("phase {0} depends on itself")]
+    SelfDependency(String),
+    /// A cycle was found.
+    #[error("phase dependency graph contains a cycle")]
+    Cycle,
+    /// A phase is missing an objective.
+    #[error("phase {0} is missing objective")]
+    MissingObjective(String),
+    /// A phase has no required artifacts.
+    #[error("phase {0} has no required artifacts")]
+    MissingArtifacts(String),
+    /// A phase has no exit gates.
+    #[error("phase {0} has no exit gates")]
+    MissingGates(String),
+}
+
+/// Validate a manifest with runtime-grade constraints.
+pub fn validate_manifest(manifest: &SuperWorkflowManifest) -> Result<(), ValidationError> {
+    expect_literal("version", "v1", &manifest.version)?;
+    expect_literal("intent", "daemon", &manifest.intent)?;
+    expect_literal("confirm", "RUN_FOREVER", &manifest.confirm)?;
+
+    let len = manifest.superworkflow.phases.len();
+    if !(9..=12).contains(&len) {
+        return Err(ValidationError::InvalidPhaseCount(len));
+    }
+    if let Some(declared) = manifest.superworkflow.stage_count {
+        if declared != len {
+            return Err(ValidationError::StageCountMismatch {
+                declared,
+                actual: len,
+            });
+        }
+    }
+
+    let mut ids = BTreeSet::new();
+    for phase in &manifest.superworkflow.phases {
+        if !ids.insert(phase.id.clone()) {
+            return Err(ValidationError::DuplicatePhaseId(phase.id.clone()));
+        }
+        if phase.objective.trim().is_empty() {
+            return Err(ValidationError::MissingObjective(phase.id.clone()));
+        }
+        if phase.exit.required_artifacts.is_empty() {
+            return Err(ValidationError::MissingArtifacts(phase.id.clone()));
+        }
+        if phase.exit.gates.is_empty() {
+            return Err(ValidationError::MissingGates(phase.id.clone()));
+        }
+    }
+
+    for phase in &manifest.superworkflow.phases {
+        for dep in &phase.depends_on {
+            if dep == &phase.id {
+                return Err(ValidationError::SelfDependency(phase.id.clone()));
+            }
+            if !ids.contains(dep) {
+                return Err(ValidationError::UnknownDependency {
+                    phase_id: phase.id.clone(),
+                    depends_on: dep.clone(),
+                });
+            }
+        }
+    }
+
+    if execution_layers(manifest).is_none() {
+        return Err(ValidationError::Cycle);
+    }
+    Ok(())
+}
+
+fn expect_literal(
+    field: &'static str,
+    expected: &'static str,
+    actual: &str,
+) -> Result<(), ValidationError> {
+    if actual == expected {
+        Ok(())
+    } else {
+        Err(ValidationError::InvalidLiteral {
+            field,
+            expected,
+            actual: actual.to_string(),
+        })
+    }
+}
+
+/// Return topological execution layers. Each inner vector can run in parallel.
+pub fn execution_layers(manifest: &SuperWorkflowManifest) -> Option<Vec<Vec<String>>> {
+    let phases = &manifest.superworkflow.phases;
+    let by_id: BTreeMap<&str, &Phase> = phases.iter().map(|phase| (phase.id.as_str(), phase)).collect();
+    let mut indegree: BTreeMap<&str, usize> = BTreeMap::new();
+    let mut outgoing: BTreeMap<&str, Vec<&str>> = BTreeMap::new();
+
+    for phase in phases {
+        indegree.entry(phase.id.as_str()).or_insert(0);
+        for dep in &phase.depends_on {
+            if !by_id.contains_key(dep.as_str()) {
+                return None;
+            }
+            outgoing.entry(dep.as_str()).or_default().push(phase.id.as_str());
+            *indegree.entry(phase.id.as_str()).or_insert(0) += 1;
+        }
+    }
+
+    let mut ready: VecDeque<&str> = indegree
+        .iter()
+        .filter_map(|(id, degree)| if *degree == 0 { Some(*id) } else { None })
+        .collect();
+    let mut layers = Vec::new();
+    let mut visited = 0usize;
+
+    while !ready.is_empty() {
+        let mut layer = Vec::new();
+        for _ in 0..ready.len() {
+            let id = ready.pop_front().expect("ready len checked");
+            visited += 1;
+            layer.push(id.to_string());
+            for next in outgoing.get(id).cloned().unwrap_or_default() {
+                let degree = indegree.get_mut(next).expect("known phase");
+                *degree -= 1;
+                if *degree == 0 {
+                    ready.push_back(next);
+                }
+            }
+        }
+        layers.push(layer);
+    }
+
+    if visited == phases.len() {
+        Some(layers)
+    } else {
+        None
+    }
+}
+
+/// Compute phases ready to run given completed and blocked phase ids.
+pub fn ready_phases(
+    manifest: &SuperWorkflowManifest,
+    completed: &BTreeSet<String>,
+    blocked: &BTreeSet<String>,
+) -> Vec<String> {
+    manifest
+        .superworkflow
+        .phases
+        .iter()
+        .filter(|phase| !completed.contains(&phase.id))
+        .filter(|phase| !blocked.contains(&phase.id))
+        .filter(|phase| phase.depends_on.iter().all(|dep| completed.contains(dep)))
+        .map(|phase| phase.id.clone())
+        .collect()
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::model::{ExitPlan, Gate, Job, SuperWorkflow, SuperWorkflowManifest};
+
+    fn phase(id: &str, deps: &[&str]) -> crate::model::Phase {
+        crate::model::Phase {
+            id: id.to_string(),
+            name: id.to_string(),
+            objective: format!("objective for {id}"),
+            depends_on: deps.iter().map(|s| s.to_string()).collect(),
+            parallel_group: String::new(),
+            agents: Default::default(),
+            budget: Default::default(),
+            exit: ExitPlan {
+                required_artifacts: vec![format!("target/{id}.json")],
+                gates: vec![Gate {
+                    kind: "artifact_exists".into(),
+                    params: Default::default(),
+                }],
+                signoff: vec!["supervisor".into()],
+            },
+        }
+    }
+
+    fn manifest() -> SuperWorkflowManifest {
+        let phases = vec![
+            phase("p00", &[]),
+            phase("p01", &["p00"]),
+            phase("p02", &["p00"]),
+            phase("p03", &["p01", "p02"]),
+            phase("p04", &["p01"]),
+            phase("p05", &["p03", "p04"]),
+            phase("p06", &["p03"]),
+            phase("p07", &["p05", "p06"]),
+            phase("p08", &["p07"]),
+        ];
+        SuperWorkflowManifest {
+            version: "v1".into(),
+            intent: "daemon".into(),
+            confirm: "RUN_FOREVER".into(),
+            id: "test".into(),
+            job: Job {
+                name: "test".into(),
+                objective: "test".into(),
+                risk: vec![],
+            },
+            superworkflow: SuperWorkflow {
+                stage_count: Some(phases.len()),
+                strategy: "test".into(),
+                controller: Default::default(),
+                memory: Default::default(),
+                sandbox: Default::default(),
+                repo_graph: Default::default(),
+                parity: Default::default(),
+                phases,
+            },
+        }
+    }
+
+    #[test]
+    fn validates_nine_phase_manifest() {
+        validate_manifest(&manifest()).expect("valid manifest");
+    }
+
+    #[test]
+    fn computes_ready_phases() {
+        let manifest = manifest();
+        let completed = BTreeSet::from(["p00".to_string()]);
+        let ready = ready_phases(&manifest, &completed, &BTreeSet::new());
+        assert_eq!(ready, vec!["p01".to_string(), "p02".to_string()]);
+    }
+
+    #[test]
+    fn rejects_cycle() {
+        let mut m = manifest();
+        m.superworkflow.phases[0].depends_on.push("p08".into());
+        assert_eq!(validate_manifest(&m), Err(ValidationError::Cycle));
+    }
+}
