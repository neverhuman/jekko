@@ -0,0 +1,631 @@
+//! SQLite persistence for SuperWorkflow runs.
+
+use std::collections::{BTreeMap, BTreeSet};
+use std::path::Path;
+
+use chrono::Utc;
+use rusqlite::{params, Connection, OptionalExtension};
+use serde_json::json;
+
+use crate::model::{PhaseStatus, SuperWorkflowManifest};
+use crate::planner::ready_phases;
+
+/// Persisted task status.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum TaskStatus {
+    /// Task is available.
+    Pending,
+    /// Task is leased to an agent.
+    Running,
+    /// Task is blocked.
+    Blocked,
+    /// Task is under review.
+    Review,
+    /// Task completed.
+    Complete,
+    /// Task parked with summary.
+    Parked,
+    /// Task failed.
+    Failed,
+}
+
+impl TaskStatus {
+    /// Stable storage string.
+    pub fn as_str(self) -> &'static str {
+        match self {
+            TaskStatus::Pending => "pending",
+            TaskStatus::Running => "running",
+            TaskStatus::Blocked => "blocked",
+            TaskStatus::Review => "review",
+            TaskStatus::Complete => "complete",
+            TaskStatus::Parked => "parked",
+            TaskStatus::Failed => "failed",
+        }
+    }
+}
+
+/// SQLite-backed supervisor store.
+pub struct SupervisorStore {
+    conn: Connection,
+}
+
+impl SupervisorStore {
+    /// Open a store at a path.
+    pub fn open(path: impl AsRef<Path>) -> rusqlite::Result<Self> {
+        let conn = Connection::open(path)?;
+        let store = Self { conn };
+        store.init_schema()?;
+        Ok(store)
+    }
+
+    /// Open an in-memory store for tests and ramdisk-like workflows.
+    pub fn open_in_memory() -> rusqlite::Result<Self> {
+        let conn = Connection::open_in_memory()?;
+        let store = Self { conn };
+        store.init_schema()?;
+        Ok(store)
+    }
+
+    /// Borrow the raw connection for advanced host integration.
+    pub fn connection(&self) -> &Connection {
+        &self.conn
+    }
+
+    /// Create tables and indexes. Idempotent.
+    pub fn init_schema(&self) -> rusqlite::Result<()> {
+        self.conn.execute_batch(
+            r#"
+            PRAGMA journal_mode = WAL;
+            PRAGMA synchronous = NORMAL;
+            PRAGMA busy_timeout = 5000;
+            PRAGMA foreign_keys = ON;
+
+            CREATE TABLE IF NOT EXISTS zyal_super_runs (
+                run_id TEXT PRIMARY KEY,
+                manifest_id TEXT NOT NULL,
+                objective TEXT NOT NULL,
+                workspace_root TEXT NOT NULL,
+                manifest_json TEXT NOT NULL,
+                status TEXT NOT NULL,
+                created_at TEXT NOT NULL,
+                updated_at TEXT NOT NULL
+            );
+
+            CREATE TABLE IF NOT EXISTS zyal_super_phases (
+                run_id TEXT NOT NULL,
+                phase_id TEXT NOT NULL,
+                name TEXT NOT NULL,
+                objective TEXT NOT NULL,
+                depends_on_json TEXT NOT NULL,
+                status TEXT NOT NULL,
+                summary TEXT NOT NULL DEFAULT '',
+                started_at TEXT,
+                completed_at TEXT,
+                updated_at TEXT NOT NULL,
+                PRIMARY KEY (run_id, phase_id),
+                FOREIGN KEY (run_id) REFERENCES zyal_super_runs(run_id) ON DELETE CASCADE
+            );
+
+            CREATE TABLE IF NOT EXISTS zyal_super_tasks (
+                run_id TEXT NOT NULL,
+                task_id TEXT NOT NULL,
+                phase_id TEXT NOT NULL,
+                title TEXT NOT NULL,
+                scope_json TEXT NOT NULL DEFAULT '{}',
+                status TEXT NOT NULL,
+                owner TEXT,
+                lease_until TEXT,
+                summary TEXT NOT NULL DEFAULT '',
+                created_at TEXT NOT NULL,
+                updated_at TEXT NOT NULL,
+                PRIMARY KEY (run_id, task_id),
+                FOREIGN KEY (run_id, phase_id) REFERENCES zyal_super_phases(run_id, phase_id) ON DELETE CASCADE
+            );
+
+            CREATE TABLE IF NOT EXISTS zyal_super_memory (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                run_id TEXT NOT NULL,
+                phase_id TEXT,
+                task_id TEXT,
+                scope TEXT NOT NULL,
+                kind TEXT NOT NULL,
+                body TEXT NOT NULL,
+                tags_json TEXT NOT NULL,
+                source_ref TEXT,
+                created_at TEXT NOT NULL,
+                FOREIGN KEY (run_id) REFERENCES zyal_super_runs(run_id) ON DELETE CASCADE
+            );
+
+            CREATE TABLE IF NOT EXISTS zyal_super_evidence (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                run_id TEXT NOT NULL,
+                phase_id TEXT,
+                task_id TEXT,
+                kind TEXT NOT NULL,
+                uri TEXT,
+                content_hash TEXT,
+                payload_json TEXT NOT NULL,
+                created_at TEXT NOT NULL,
+                FOREIGN KEY (run_id) REFERENCES zyal_super_runs(run_id) ON DELETE CASCADE
+            );
+
+            CREATE TABLE IF NOT EXISTS zyal_super_repo_symbols (
+                run_id TEXT NOT NULL,
+                symbol_id TEXT NOT NULL,
+                kind TEXT NOT NULL,
+                path TEXT NOT NULL,
+                name TEXT NOT NULL,
+                span_json TEXT NOT NULL DEFAULT '{}',
+                metadata_json TEXT NOT NULL DEFAULT '{}',
+                updated_at TEXT NOT NULL,
+                PRIMARY KEY (run_id, symbol_id),
+                FOREIGN KEY (run_id) REFERENCES zyal_super_runs(run_id) ON DELETE CASCADE
+            );
+
+            CREATE TABLE IF NOT EXISTS zyal_super_repo_edges (
+                run_id TEXT NOT NULL,
+                edge_id TEXT NOT NULL,
+                src_symbol_id TEXT NOT NULL,
+                dst_symbol_id TEXT NOT NULL,
+                kind TEXT NOT NULL,
+                weight REAL NOT NULL DEFAULT 1.0,
+                evidence_json TEXT NOT NULL DEFAULT '{}',
+                updated_at TEXT NOT NULL,
+                PRIMARY KEY (run_id, edge_id),
+                FOREIGN KEY (run_id) REFERENCES zyal_super_runs(run_id) ON DELETE CASCADE
+            );
+
+            CREATE TABLE IF NOT EXISTS zyal_super_signoffs (
+                id INTEGER PRIMARY KEY AUTOINCREMENT,
+                run_id TEXT NOT NULL,
+                phase_id TEXT NOT NULL,
+                kind TEXT NOT NULL,
+                agent TEXT NOT NULL,
+                verdict TEXT NOT NULL,
+                notes TEXT NOT NULL DEFAULT '',
+                created_at TEXT NOT NULL,
+                FOREIGN KEY (run_id, phase_id) REFERENCES zyal_super_phases(run_id, phase_id) ON DELETE CASCADE
+            );
+
+            CREATE INDEX IF NOT EXISTS zyal_super_phase_status_idx
+                ON zyal_super_phases(run_id, status);
+            CREATE INDEX IF NOT EXISTS zyal_super_task_status_idx
+                ON zyal_super_tasks(run_id, phase_id, status);
+            CREATE INDEX IF NOT EXISTS zyal_super_memory_lookup_idx
+                ON zyal_super_memory(run_id, scope, kind);
+            CREATE INDEX IF NOT EXISTS zyal_super_evidence_lookup_idx
+                ON zyal_super_evidence(run_id, kind, content_hash);
+            CREATE INDEX IF NOT EXISTS zyal_super_repo_symbol_path_idx
+                ON zyal_super_repo_symbols(run_id, path);
+            CREATE INDEX IF NOT EXISTS zyal_super_repo_edge_kind_idx
+                ON zyal_super_repo_edges(run_id, kind);
+            "#,
+        )?;
+        Ok(())
+    }
+
+    /// Initialize a run and seed all phases as pending.
+    pub fn init_run(
+        &self,
+        manifest: &SuperWorkflowManifest,
+        run_id: &str,
+        workspace_root: &str,
+    ) -> rusqlite::Result<()> {
+        let now = Utc::now().to_rfc3339();
+        let manifest_json = serde_json::to_string(manifest)
+            .map_err(|err| rusqlite::Error::ToSqlConversionFailure(Box::new(err)))?;
+        self.conn.execute(
+            r#"
+            INSERT OR REPLACE INTO zyal_super_runs (
+                run_id, manifest_id, objective, workspace_root, manifest_json, status, created_at, updated_at
+            ) VALUES (?1, ?2, ?3, ?4, ?5, 'running', ?6, ?6)
+            "#,
+            params![run_id, manifest.id, manifest.job.objective, workspace_root, manifest_json, now],
+        )?;
+        for phase in &manifest.superworkflow.phases {
+            let depends = serde_json::to_string(&phase.depends_on)
+                .map_err(|err| rusqlite::Error::ToSqlConversionFailure(Box::new(err)))?;
+            self.conn.execute(
+                r#"
+                INSERT OR REPLACE INTO zyal_super_phases (
+                    run_id, phase_id, name, objective, depends_on_json, status, updated_at
+                ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)
+                "#,
+                params![
+                    run_id,
+                    phase.id,
+                    phase.name,
+                    phase.objective,
+                    depends,
+                    PhaseStatus::Pending.as_str(),
+                    now,
+                ],
+            )?;
+        }
+        self.refresh_ready_phases(manifest, run_id)?;
+        Ok(())
+    }
+
+    /// Mark dependency-satisfied pending phases as ready.
+    pub fn refresh_ready_phases(
+        &self,
+        manifest: &SuperWorkflowManifest,
+        run_id: &str,
+    ) -> rusqlite::Result<Vec<String>> {
+        let completed = self.completed_phases(run_id)?;
+        let blocked = self.blocked_phases(run_id)?;
+        let ready = ready_phases(manifest, &completed, &blocked);
+        let now = Utc::now().to_rfc3339();
+        for phase_id in &ready {
+            self.conn.execute(
+                r#"
+                UPDATE zyal_super_phases
+                SET status = ?1, updated_at = ?2
+                WHERE run_id = ?3 AND phase_id = ?4 AND status = 'pending'
+                "#,
+                params![PhaseStatus::Ready.as_str(), now, run_id, phase_id],
+            )?;
+        }
+        Ok(ready)
+    }
+
+    /// Return completed phase ids.
+    pub fn completed_phases(&self, run_id: &str) -> rusqlite::Result<BTreeSet<String>> {
+        self.phase_ids_with_status(run_id, PhaseStatus::Complete)
+    }
+
+    /// Return blocked phase ids.
+    pub fn blocked_phases(&self, run_id: &str) -> rusqlite::Result<BTreeSet<String>> {
+        self.phase_ids_with_status(run_id, PhaseStatus::Blocked)
+    }
+
+    fn phase_ids_with_status(
+        &self,
+        run_id: &str,
+        status: PhaseStatus,
+    ) -> rusqlite::Result<BTreeSet<String>> {
+        let mut stmt = self.conn.prepare(
+            "SELECT phase_id FROM zyal_super_phases WHERE run_id = ?1 AND status = ?2 ORDER BY phase_id",
+        )?;
+        let rows = stmt.query_map(params![run_id, status.as_str()], |row| row.get::<_, String>(0))?;
+        let mut out = BTreeSet::new();
+        for row in rows {
+            out.insert(row?);
+        }
+        Ok(out)
+    }
+
+    /// Return phase statuses.
+    pub fn phase_statuses(&self, run_id: &str) -> rusqlite::Result<BTreeMap<String, PhaseStatus>> {
+        let mut stmt = self.conn.prepare(
+            "SELECT phase_id, status FROM zyal_super_phases WHERE run_id = ?1 ORDER BY phase_id",
+        )?;
+        let rows = stmt.query_map(params![run_id], |row| {
+            let id: String = row.get(0)?;
+            let raw: String = row.get(1)?;
+            let status = PhaseStatus::parse(&raw).unwrap_or(PhaseStatus::Failed);
+            Ok((id, status))
+        })?;
+        let mut out = BTreeMap::new();
+        for row in rows {
+            let (id, status) = row?;
+            out.insert(id, status);
+        }
+        Ok(out)
+    }
+
+    /// Record a phase status update.
+    pub fn record_phase_status(
+        &self,
+        run_id: &str,
+        phase_id: &str,
+        status: PhaseStatus,
+        summary: &str,
+    ) -> rusqlite::Result<()> {
+        let now = Utc::now().to_rfc3339();
+        let completed_at = if status == PhaseStatus::Complete { Some(now.clone()) } else { None };
+        self.conn.execute(
+            r#"
+            UPDATE zyal_super_phases
+            SET status = ?1,
+                summary = CASE WHEN ?2 = '' THEN summary ELSE ?2 END,
+                completed_at = COALESCE(?3, completed_at),
+                updated_at = ?4
+            WHERE run_id = ?5 AND phase_id = ?6
+            "#,
+            params![status.as_str(), summary, completed_at, now, run_id, phase_id],
+        )?;
+        Ok(())
+    }
+
+    /// Append memory.
+    pub fn append_memory(
+        &self,
+        run_id: &str,
+        phase_id: Option<&str>,
+        task_id: Option<&str>,
+        scope: &str,
+        kind: &str,
+        body: &str,
+        tags: &[String],
+        source_ref: Option<&str>,
+    ) -> rusqlite::Result<i64> {
+        let now = Utc::now().to_rfc3339();
+        let tags_json = serde_json::to_string(tags)
+            .map_err(|err| rusqlite::Error::ToSqlConversionFailure(Box::new(err)))?;
+        self.conn.execute(
+            r#"
+            INSERT INTO zyal_super_memory (
+                run_id, phase_id, task_id, scope, kind, body, tags_json, source_ref, created_at
+            ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9)
+            "#,
+            params![run_id, phase_id, task_id, scope, kind, body, tags_json, source_ref, now],
+        )?;
+        Ok(self.conn.last_insert_rowid())
+    }
+
+    /// Append evidence.
+    pub fn append_evidence(
+        &self,
+        run_id: &str,
+        phase_id: Option<&str>,
+        task_id: Option<&str>,
+        kind: &str,
+        uri: Option<&str>,
+        content_hash: Option<&str>,
+        payload: &serde_json::Value,
+    ) -> rusqlite::Result<i64> {
+        let now = Utc::now().to_rfc3339();
+        self.conn.execute(
+            r#"
+            INSERT INTO zyal_super_evidence (
+                run_id, phase_id, task_id, kind, uri, content_hash, payload_json, created_at
+            ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)
+            "#,
+            params![run_id, phase_id, task_id, kind, uri, content_hash, payload.to_string(), now],
+        )?;
+        Ok(self.conn.last_insert_rowid())
+    }
+
+    /// Upsert a repo graph symbol.
+    pub fn upsert_repo_symbol(
+        &self,
+        run_id: &str,
+        symbol_id: &str,
+        kind: &str,
+        path: &str,
+        name: &str,
+        span: &serde_json::Value,
+        metadata: &serde_json::Value,
+    ) -> rusqlite::Result<()> {
+        let now = Utc::now().to_rfc3339();
+        self.conn.execute(
+            r#"
+            INSERT INTO zyal_super_repo_symbols (
+                run_id, symbol_id, kind, path, name, span_json, metadata_json, updated_at
+            ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)
+            ON CONFLICT(run_id, symbol_id) DO UPDATE SET
+                kind = excluded.kind,
+                path = excluded.path,
+                name = excluded.name,
+                span_json = excluded.span_json,
+                metadata_json = excluded.metadata_json,
+                updated_at = excluded.updated_at
+            "#,
+            params![run_id, symbol_id, kind, path, name, span.to_string(), metadata.to_string(), now],
+        )?;
+        Ok(())
+    }
+
+    /// Append or update a repo graph edge.
+    pub fn append_repo_edge(
+        &self,
+        run_id: &str,
+        edge_id: &str,
+        src_symbol_id: &str,
+        dst_symbol_id: &str,
+        kind: &str,
+        weight: f64,
+        evidence: &serde_json::Value,
+    ) -> rusqlite::Result<()> {
+        let now = Utc::now().to_rfc3339();
+        self.conn.execute(
+            r#"
+            INSERT INTO zyal_super_repo_edges (
+                run_id, edge_id, src_symbol_id, dst_symbol_id, kind, weight, evidence_json, updated_at
+            ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8)
+            ON CONFLICT(run_id, edge_id) DO UPDATE SET
+                src_symbol_id = excluded.src_symbol_id,
+                dst_symbol_id = excluded.dst_symbol_id,
+                kind = excluded.kind,
+                weight = excluded.weight,
+                evidence_json = excluded.evidence_json,
+                updated_at = excluded.updated_at
+            "#,
+            params![run_id, edge_id, src_symbol_id, dst_symbol_id, kind, weight, evidence.to_string(), now],
+        )?;
+        Ok(())
+    }
+
+    /// Record a sign-off verdict.
+    pub fn sign_off(
+        &self,
+        run_id: &str,
+        phase_id: &str,
+        kind: &str,
+        agent: &str,
+        verdict: &str,
+        notes: &str,
+    ) -> rusqlite::Result<i64> {
+        let now = Utc::now().to_rfc3339();
+        self.conn.execute(
+            r#"
+            INSERT INTO zyal_super_signoffs (
+                run_id, phase_id, kind, agent, verdict, notes, created_at
+            ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)
+            "#,
+            params![run_id, phase_id, kind, agent, verdict, notes, now],
+        )?;
+        Ok(self.conn.last_insert_rowid())
+    }
+
+    /// Load the stored manifest for a run.
+    pub fn load_manifest(&self, run_id: &str) -> rusqlite::Result<Option<SuperWorkflowManifest>> {
+        let raw: Option<String> = self
+            .conn
+            .query_row(
+                "SELECT manifest_json FROM zyal_super_runs WHERE run_id = ?1",
+                params![run_id],
+                |row| row.get(0),
+            )
+            .optional()?;
+        raw.map(|text| {
+            serde_json::from_str(&text)
+                .map_err(|err| rusqlite::Error::FromSqlConversionFailure(0, rusqlite::types::Type::Text, Box::new(err)))
+        })
+        .transpose()
+    }
+
+    /// Insert an example task for hosts that want lightweight task materialization.
+    pub fn insert_task(
+        &self,
+        run_id: &str,
+        phase_id: &str,
+        task_id: &str,
+        title: &str,
+        scope: &serde_json::Value,
+    ) -> rusqlite::Result<()> {
+        let now = Utc::now().to_rfc3339();
+        self.conn.execute(
+            r#"
+            INSERT OR IGNORE INTO zyal_super_tasks (
+                run_id, task_id, phase_id, title, scope_json, status, created_at, updated_at
+            ) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?7)
+            "#,
+            params![run_id, task_id, phase_id, title, scope.to_string(), TaskStatus::Pending.as_str(), now],
+        )?;
+        Ok(())
+    }
+
+    /// Convenience: append a compact run event to evidence.
+    pub fn append_run_event(
+        &self,
+        run_id: &str,
+        kind: &str,
+        payload: serde_json::Value,
+    ) -> rusqlite::Result<i64> {
+        self.append_evidence(run_id, None, None, kind, None, None, &json!(payload))
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::model::{ExitPlan, Gate, Job, Phase, SuperWorkflow};
+
+    fn manifest() -> SuperWorkflowManifest {
+        let phases = (0..9)
+            .map(|idx| Phase {
+                id: format!("p{idx:02}"),
+                name: format!("phase {idx}"),
+                objective: "objective".into(),
+                depends_on: if idx == 0 { vec![] } else { vec![format!("p{:02}", idx - 1)] },
+                parallel_group: String::new(),
+                agents: Default::default(),
+                budget: Default::default(),
+                exit: ExitPlan {
+                    required_artifacts: vec![format!("target/p{idx:02}.json")],
+                    gates: vec![Gate { kind: "artifact_exists".into(), params: Default::default() }],
+                    signoff: vec!["supervisor".into()],
+                },
+            })
+            .collect::<Vec<_>>();
+        SuperWorkflowManifest {
+            version: "v1".into(),
+            intent: "daemon".into(),
+            confirm: "RUN_FOREVER".into(),
+            id: "manifest".into(),
+            job: Job { name: "job".into(), objective: "objective".into(), risk: vec![] },
+            superworkflow: SuperWorkflow {
+                stage_count: Some(phases.len()),
+                strategy: "test".into(),
+                controller: Default::default(),
+                memory: Default::default(),
+                sandbox: Default::default(),
+                repo_graph: Default::default(),
+                parity: Default::default(),
+                phases,
+            },
+        }
+    }
+
+    #[test]
+    fn initializes_run_and_refreshes_ready_phase() {
+        let store = SupervisorStore::open_in_memory().unwrap();
+        let m = manifest();
+        store.init_run(&m, "run-1", ".zyal/sandboxes/run-1").unwrap();
+        let statuses = store.phase_statuses("run-1").unwrap();
+        assert_eq!(statuses.get("p00"), Some(&PhaseStatus::Ready));
+        assert_eq!(statuses.get("p01"), Some(&PhaseStatus::Pending));
+        store.record_phase_status("run-1", "p00", PhaseStatus::Complete, "done").unwrap();
+        let ready = store.refresh_ready_phases(&m, "run-1").unwrap();
+        assert!(ready.contains(&"p01".to_string()));
+    }
+
+    #[test]
+    fn persists_memory_evidence_graph_and_signoff() {
+        let store = SupervisorStore::open_in_memory().unwrap();
+        let m = manifest();
+        store.init_run(&m, "run-1", ".zyal/sandboxes/run-1").unwrap();
+        let memory_id = store
+            .append_memory(
+                "run-1",
+                Some("p00"),
+                None,
+                "phase",
+                "negative_lesson",
+                "Do not merge without parity evidence.",
+                &["parity".into()],
+                None,
+            )
+            .unwrap();
+        assert!(memory_id > 0);
+        store
+            .append_evidence(
+                "run-1",
+                Some("p00"),
+                None,
+                "proof",
+                Some("target/proof.json"),
+                Some("sha256:test"),
+                &json!({"ok": true}),
+            )
+            .unwrap();
+        store
+            .upsert_repo_symbol(
+                "run-1",
+                "sym:main",
+                "function",
+                "src/main.rs",
+                "main",
+                &json!({"start": 1, "end": 10}),
+                &json!({"public": false}),
+            )
+            .unwrap();
+        store
+            .append_repo_edge(
+                "run-1",
+                "edge:main:handler",
+                "sym:main",
+                "sym:handler",
+                "calls",
+                1.0,
+                &json!({"source": "static"}),
+            )
+            .unwrap();
+        let signoff = store
+            .sign_off("run-1", "p00", "phase", "critic", "approved", "looks bounded")
+            .unwrap();
+        assert!(signoff > 0);
+    }
+}
diff --git a/crates/zyal-supervisor/src/main.rs b/crates/zyal-supervisor/src/main.rs
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/crates/zyal-supervisor/src/main.rs
@@ -0,0 +1,211 @@
+use std::path::PathBuf;
+
+use anyhow::{Context, Result};
+use clap::{Parser, Subcommand};
+use serde_json::json;
+use zyal_supervisor::{validate_manifest, PhaseStatus, SupervisorStore, SuperWorkflowManifest};
+
+#[derive(Parser, Debug)]
+#[command(
+    name = "zyal-supervisor",
+    version,
+    about = "Durable supervisor substrate for ambitious ZYAL SuperWorkflows"
+)]
+struct Cli {
+    #[command(subcommand)]
+    cmd: Cmd,
+}
+
+#[derive(Subcommand, Debug)]
+enum Cmd {
+    /// Validate a SuperWorkflow manifest.
+    Validate {
+        /// Manifest path (JSON or YAML).
+        #[arg(long)]
+        manifest: PathBuf,
+    },
+    /// Initialize persistent run state.
+    InitRun {
+        /// Manifest path (JSON or YAML).
+        #[arg(long)]
+        manifest: PathBuf,
+        /// SQLite DB path.
+        #[arg(long)]
+        db: PathBuf,
+        /// Run id.
+        #[arg(long)]
+        run_id: String,
+        /// Persistent workspace root.
+        #[arg(long)]
+        workspace_root: String,
+    },
+    /// Print ready phases as JSON.
+    Ready {
+        /// SQLite DB path.
+        #[arg(long)]
+        db: PathBuf,
+        /// Run id.
+        #[arg(long)]
+        run_id: String,
+    },
+    /// Record phase status.
+    RecordPhase {
+        /// SQLite DB path.
+        #[arg(long)]
+        db: PathBuf,
+        /// Run id.
+        #[arg(long)]
+        run_id: String,
+        /// Phase id.
+        #[arg(long)]
+        phase_id: String,
+        /// Status: pending|ready|running|blocked|review|complete|parked|failed.
+        #[arg(long)]
+        status: String,
+        /// Optional summary.
+        #[arg(long, default_value = "")]
+        summary: String,
+    },
+    /// Append a memory record.
+    Remember {
+        /// SQLite DB path.
+        #[arg(long)]
+        db: PathBuf,
+        /// Run id.
+        #[arg(long)]
+        run_id: String,
+        /// Optional phase id.
+        #[arg(long)]
+        phase_id: Option<String>,
+        /// Optional task id.
+        #[arg(long)]
+        task_id: Option<String>,
+        /// Memory scope.
+        #[arg(long, default_value = "run")]
+        scope: String,
+        /// Memory kind.
+        #[arg(long)]
+        kind: String,
+        /// Body.
+        #[arg(long)]
+        body: String,
+        /// Comma-separated tags.
+        #[arg(long, default_value = "")]
+        tags: String,
+    },
+    /// Record a phase sign-off verdict.
+    Signoff {
+        /// SQLite DB path.
+        #[arg(long)]
+        db: PathBuf,
+        /// Run id.
+        #[arg(long)]
+        run_id: String,
+        /// Phase id.
+        #[arg(long)]
+        phase_id: String,
+        /// Sign-off kind.
+        #[arg(long, default_value = "phase")]
+        kind: String,
+        /// Agent or role.
+        #[arg(long)]
+        agent: String,
+        /// Verdict.
+        #[arg(long)]
+        verdict: String,
+        /// Notes.
+        #[arg(long, default_value = "")]
+        notes: String,
+    },
+}
+
+fn main() {
+    let cli = Cli::parse();
+    let code = match dispatch(cli) {
+        Ok(code) => code,
+        Err(err) => {
+            eprintln!("zyal-supervisor: {err:#}");
+            1
+        }
+    };
+    std::process::exit(code);
+}
+
+fn dispatch(cli: Cli) -> Result<i32> {
+    match cli.cmd {
+        Cmd::Validate { manifest } => {
+            let manifest = load_manifest(&manifest)?;
+            validate_manifest(&manifest).context("validate manifest")?;
+            println!("{}", json!({"ok": true, "id": manifest.id, "phases": manifest.superworkflow.phases.len()}));
+            Ok(0)
+        }
+        Cmd::InitRun { manifest, db, run_id, workspace_root } => {
+            let manifest = load_manifest(&manifest)?;
+            validate_manifest(&manifest).context("validate manifest")?;
+            let store = SupervisorStore::open(db).context("open supervisor store")?;
+            store.init_run(&manifest, &run_id, &workspace_root).context("init run")?;
+            println!("{}", json!({"ok": true, "run_id": run_id, "manifest_id": manifest.id}));
+            Ok(0)
+        }
+        Cmd::Ready { db, run_id } => {
+            let store = SupervisorStore::open(db).context("open supervisor store")?;
+            let manifest = store
+                .load_manifest(&run_id)
+                .context("load manifest")?
+                .context("unknown run id")?;
+            let ready = store.refresh_ready_phases(&manifest, &run_id).context("refresh ready")?;
+            println!("{}", json!({"run_id": run_id, "ready": ready}));
+            Ok(0)
+        }
+        Cmd::RecordPhase { db, run_id, phase_id, status, summary } => {
+            let status = PhaseStatus::parse(&status).context("invalid status")?;
+            let store = SupervisorStore::open(db).context("open supervisor store")?;
+            store.record_phase_status(&run_id, &phase_id, status, &summary).context("record phase")?;
+            if let Some(manifest) = store.load_manifest(&run_id).context("load manifest")? {
+                store.refresh_ready_phases(&manifest, &run_id).context("refresh ready phases")?;
+            }
+            println!("{}", json!({"ok": true, "run_id": run_id, "phase_id": phase_id, "status": status.as_str()}));
+            Ok(0)
+        }
+        Cmd::Remember { db, run_id, phase_id, task_id, scope, kind, body, tags } => {
+            let tags = tags
+                .split(',')
+                .map(str::trim)
+                .filter(|tag| !tag.is_empty())
+                .map(str::to_string)
+                .collect::<Vec<_>>();
+            let store = SupervisorStore::open(db).context("open supervisor store")?;
+            let id = store
+                .append_memory(
+                    &run_id,
+                    phase_id.as_deref(),
+                    task_id.as_deref(),
+                    &scope,
+                    &kind,
+                    &body,
+                    &tags,
+                    None,
+                )
+                .context("append memory")?;
+            println!("{}", json!({"ok": true, "id": id}));
+            Ok(0)
+        }
+        Cmd::Signoff { db, run_id, phase_id, kind, agent, verdict, notes } => {
+            let store = SupervisorStore::open(db).context("open supervisor store")?;
+            let id = store
+                .sign_off(&run_id, &phase_id, &kind, &agent, &verdict, &notes)
+                .context("signoff")?;
+            println!("{}", json!({"ok": true, "id": id}));
+            Ok(0)
+        }
+    }
+}
+
+fn load_manifest(path: &PathBuf) -> Result<SuperWorkflowManifest> {
+    let text = std::fs::read_to_string(path).with_context(|| format!("read {}", path.display()))?;
+    if path.extension().and_then(|ext| ext.to_str()) == Some("json") {
+        serde_json::from_str(&text).context("parse JSON manifest")
+    } else {
+        serde_yaml::from_str(&text).context("parse YAML manifest")
+    }
+}
