{
  "id": "tool-read",
  "title": "Read-tool loop with deterministic follow-up",
  "tags": ["deterministic", "tool-call", "read"],
  "provider": "dummy_agent_llm",
  "model": "tool-read",
  "stages": [
    {
      "when": "initial",
      "frames": [
        { "type": "stream-start" },
        {
          "type": "tool-call",
          "id": "dummy-tool-read-1",
          "name": "read",
          "input": { "filePath": "{{first_path}}" }
        },
        { "type": "usage", "input_tokens": 0, "output_tokens": 0 },
        { "type": "stream-end", "stop_reason": "tool-call" }
      ]
    },
    {
      "when": "after-tool-result",
      "frames": [
        { "type": "stream-start" },
        { "type": "text-delta", "text": "dummy_agent_llm/tool-read: tool result received." },
        { "type": "usage", "input_tokens": 0, "output_tokens": 0 },
        { "type": "stream-end", "stop_reason": "stop" }
      ]
    }
  ]
}
