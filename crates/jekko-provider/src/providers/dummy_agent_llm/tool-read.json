{
  "id": "tool-read",
  "title": "Read tool call loop",
  "tags": ["tool", "read", "deterministic", "no-network"],
  "provider": "dummy_agent_llm",
  "model": "tool-read",
  "stages": [
    {
      "when": "initial",
      "frames": [
        { "type": "stream-start", "model": "dummy_agent_llm/tool-read" },
        {
          "type": "tool-call",
          "id": "dummy-read-1",
          "name": "read",
          "input": {
            "filePath": "{{first_path}}",
            "offset": 1,
            "limit": 2000
          }
        },
        { "type": "usage", "input_tokens": 0, "output_tokens": 0 },
        { "type": "stream-end", "stop_reason": "tool-calls" }
      ]
    },
    {
      "when": "after-tool-result",
      "frames": [
        { "type": "stream-start", "model": "dummy_agent_llm/tool-read" },
        { "type": "text-delta", "text": "dummy_agent_llm/tool-read: tool result received." },
        { "type": "usage", "input_tokens": 0, "output_tokens": 0 },
        {
          "type": "metadata",
          "metadata": {
            "provider": "dummy_agent_llm",
            "scenario_id": "tool-read",
            "tool_result_seen": true
          }
        },
        { "type": "stream-end", "stop_reason": "stop" }
      ]
    }
  ]
}
