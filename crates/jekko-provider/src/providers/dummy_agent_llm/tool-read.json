{
  "id": "tool-read",
  "title": "Read-tool workflow",
  "tags": ["tool-call", "read", "offline", "deterministic"],
  "provider": "dummy_agent_llm",
  "model": "tool-read",
  "stages": [
    {
      "when": "initial",
      "frames": [
        { "type": "stream-start" },
        { "type": "text-delta", "text": "I will inspect the requested file with the read tool." },
        {
          "type": "tool-call",
          "id": "dummy-read-1",
          "name": "read",
          "input": {
            "filePath": "{{first_path}}",
            "offset": 1,
            "limit": 20
          }
        },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        },
        { "type": "stream-end", "stop_reason": "tool-call" }
      ]
    },
    {
      "when": "after-tool-result",
      "frames": [
        { "type": "stream-start" },
        { "type": "text-delta", "text": "Read completed deterministically for " },
        { "type": "text-delta", "text": "{{first_path}}" },
        { "type": "text-delta", "text": "." },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        },
        { "type": "stream-end", "stop_reason": "stop" }
      ]
    }
  ]
}
