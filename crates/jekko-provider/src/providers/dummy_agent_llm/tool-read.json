{
  "id": "tool-read",
  "title": "Read-tool agent loop simulation",
  "tags": ["deterministic", "tool-call", "read", "no-network"],
  "provider": "dummy_agent_llm",
  "model": "tool-read",
  "stages": [
    {
      "when": "initial",
      "frames": [
        {
          "type": "stream-start"
        },
        {
          "type": "text-delta",
          "text": "dummy_agent_llm/tool-read: requesting read tool."
        },
        {
          "type": "tool-call",
          "id": "call_read_1",
          "name": "read",
          "input": {
            "filePath": "{{first_path}}"
          }
        },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        },
        {
          "type": "metadata",
          "metadata": {
            "scenario_id": "tool-read",
            "stage": "initial",
            "deterministic": true,
            "network": false,
            "cost_usd": 0
          }
        },
        {
          "type": "stream-end",
          "stop_reason": "tool-calls"
        }
      ]
    },
    {
      "when": "after-tool-result",
      "frames": [
        {
          "type": "stream-start"
        },
        {
          "type": "text-delta",
          "text": "dummy_agent_llm/tool-read: tool result received."
        },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        },
        {
          "type": "metadata",
          "metadata": {
            "scenario_id": "tool-read",
            "stage": "after-tool-result",
            "deterministic": true,
            "network": false,
            "cost_usd": 0
          }
        },
        {
          "type": "stream-end",
          "stop_reason": "stop"
        }
      ]
    }
  ]
}
