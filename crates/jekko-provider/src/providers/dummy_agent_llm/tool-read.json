{
  "id": "tool-read",
  "title": "Read-tool request followed by deterministic final answer",
  "tags": ["deterministic", "tool-call", "read", "local"],
  "provider": "dummy_agent_llm",
  "model": "tool-read",
  "stages": [
    {
      "when": "initial",
      "frames": [
        { "type": "stream-start" },
        {
          "type": "text-delta",
          "text": "dummy_agent_llm/tool-read: requesting read tool."
        },
        {
          "type": "tool-call",
          "id": "dummy-read-1",
          "name": "read",
          "input": {
            "filePath": "{{first_path}}",
            "offset": 1,
            "limit": 2000
          }
        },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        },
        { "type": "stream-end", "stop_reason": "tool-calls" }
      ]
    },
    {
      "when": "after-tool-result",
      "frames": [
        { "type": "stream-start" },
        {
          "type": "text-delta",
          "text": "dummy_agent_llm/tool-read: tool result received."
        },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        },
        {
          "type": "metadata",
          "metadata": {
            "provider": "dummy_agent_llm",
            "scenario_id": "tool-read",
            "model": "tool-read",
            "network": "disabled",
            "cost_usd": 0
          }
        },
        { "type": "stream-end", "stop_reason": "stop" }
      ]
    }
  ]
}
