{
  "id": "tool-read",
  "title": "Read tool loop",
  "tags": ["tool-call", "read", "deterministic", "local"],
  "provider": "dummy_agent_llm",
  "model": "tool-read",
  "stages": [
    {
      "when": "initial",
      "frames": [
        { "type": "stream-start" },
        { "type": "text-delta", "text": "dummy_agent_llm/tool-read: requesting read for {{first_path}}." },
        {
          "type": "tool-call",
          "id": "call_read_1",
          "name": "read",
          "input": {
            "filePath": "{{first_path}}"
          }
        },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        },
        { "type": "stream-end", "stop_reason": "tool-calls" }
      ]
    },
    {
      "when": "after-tool-result",
      "frames": [
        { "type": "stream-start" },
        { "type": "text-delta", "text": "dummy_agent_llm/tool-read: tool result received." },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        },
        { "type": "stream-end", "stop_reason": "stop" }
      ]
    }
  ]
}
