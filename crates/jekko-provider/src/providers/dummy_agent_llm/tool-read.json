{
  "id": "tool-read",
  "title": "Read tool loop",
  "tags": ["tool-call", "streaming", "zero-cost"],
  "provider": "dummy_agent_llm",
  "model": "tool-read",
  "stages": [
    {
      "when": "initial",
      "frames": [
        { "type": "stream-start" },
        {
          "type": "text-delta",
          "text": "dummy_agent_llm/tool-read: requesting read tool."
        },
        {
          "type": "tool-call",
          "id": "dummy-read-1",
          "name": "read",
          "input": {
            "filePath": "{{first_path}}",
            "offset": 1,
            "limit": 40
          }
        },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0
        },
        {
          "type": "stream-end",
          "stop_reason": "tool-call"
        }
      ]
    },
    {
      "when": "after-tool-result",
      "frames": [
        { "type": "stream-start" },
        {
          "type": "text-delta",
          "text": "dummy_agent_llm/tool-read: tool result received."
        },
        {
          "type": "metadata",
          "metadata": {
            "scenario_id": "tool-read",
            "tool_result_seen": true
          }
        },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0
        },
        {
          "type": "stream-end",
          "stop_reason": "stop"
        }
      ]
    }
  ]
}
