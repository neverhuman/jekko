{
  "id": "basic",
  "title": "Deterministic text response",
  "tags": ["deterministic", "text", "no-network"],
  "provider": "dummy_agent_llm",
  "model": "basic",
  "stages": [
    {
      "when": "initial",
      "frames": [
        { "type": "stream-start" },
        { "type": "text-delta", "text": "dummy_agent_llm/basic: " },
        { "type": "text-delta", "text": "received deterministic request: {{last_user_text}}" },
        { "type": "usage", "input_tokens": 0, "output_tokens": 0 },
        { "type": "stream-end", "stop_reason": "stop" }
      ]
    }
  ]
}
