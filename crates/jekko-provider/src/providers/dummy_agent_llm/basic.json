{
  "id": "basic",
  "title": "Deterministic text-only response",
  "tags": ["text", "deterministic", "no-network"],
  "provider": "dummy_agent_llm",
  "model": "basic",
  "stages": [
    {
      "when": "initial",
      "frames": [
        { "type": "stream-start" },
        {
          "type": "text-delta",
          "text": "dummy_agent_llm/basic: deterministic response for `"
        },
        { "type": "text-delta", "text": "{{last_user_text}}" },
        { "type": "text-delta", "text": "`." },
        {
          "type": "usage",
          "input_tokens": 0,
          "output_tokens": 0,
          "cache_read_tokens": 0,
          "cache_write_tokens": 0
        },
        {
          "type": "metadata",
          "metadata": {
            "provider": "dummy_agent_llm",
            "scenario_id": "basic",
            "deterministic": true,
            "network": false,
            "cost_usd": 0
          }
        },
        { "type": "stream-end", "stop_reason": "stop" }
      ]
    }
  ]
}
