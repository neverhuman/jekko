{
  "id": "basic",
  "title": "Deterministic text response",
  "tags": ["text", "streaming", "zero-cost"],
  "provider": "dummy_agent_llm",
  "model": "basic",
  "stages": [
    {
      "when": "initial",
      "frames": [
        { "type": "stream-start" },
        {
          "type": "metadata",
          "metadata": {
            "provider": "dummy_agent_llm",
            "scenario_id": "basic",
            "model": "basic",
            "usage_cost_usd": 0
          }
        },
        {
          "type": "text-delta",
          "text": "dummy_agent_llm/basic: deterministic response for "
        },
        { "type": "text-delta", "text": "{{last_user_text}}" },
        { "type": "usage", "input_tokens": 0, "output_tokens": 0 },
        { "type": "stream-end", "stop_reason": "stop" }
      ]
    }
  ]
}
